*********************************************************************
* MEMBER   : MBKMQDEF                                               *
* TITLE    : MQ OBJECTS FOR CORE BANKING - QUEUE MANAGER MQP1       *
* INPUT TO : CSQUTIL COMMAND FUNCTION (JOB MBKMQDEF - MQ ADMIN)     *
*-------------------------------------------------------------------*
* THE PAYMENTS GATEWAY RUNS ON QUEUE MANAGER PGWP1 (AIX). CHANNELS  *
* MQP1.TO.PGWP1 / PGWP1.TO.MQP1 ARE DEFINED BY THE MIDDLEWARE TEAM. *
*-------------------------------------------------------------------*
* HISTORY                                                           *
* 2011-06-13 JNB  CARD AUTHORISATION STANDBY BRIDGE QUEUES. NOTE ON *
*                 THE FX FIXING FILE (C:D + CA-7, NO MQ)            *
*********************************************************************
*
* ---- FASTER PAYMENTS / CHAPS OUTBOUND (HOST -> GATEWAY) -----------
DEFINE QREMOTE('MBK.FPS.OUTBOUND') +
       DESCR('FPS SINGLE IMMEDIATE PAYMENTS TO GATEWAY') +
       RNAME('PGW.FPS.REQUEST') RQMNAME('PGWP1') +
       XMITQ('PGWP1') DEFPSIST(YES) REPLACE
DEFINE QREMOTE('MBK.CHAPS.OUTBOUND') +
       DESCR('CHAPS PAYMENTS TO GATEWAY') +
       RNAME('PGW.CHAPS.REQUEST') RQMNAME('PGWP1') +
       XMITQ('PGWP1') DEFPSIST(YES) REPLACE
*
* ---- FASTER PAYMENTS RESPONSES (GATEWAY -> HOST), TRIGGERS PYFR ---
DEFINE QLOCAL('MBK.FPS.RESPONSE') +
       DESCR('FPS GATEWAY RESPONSES - TRIGGERS CICS PYFR') +
       DEFPSIST(YES) MAXDEPTH(100000) MAXMSGL(4096) +
       TRIGGER TRIGTYPE(FIRST) +
       INITQ('CICSPRD1.INITQ') PROCESS('MBK.PYFR.PROCESS') +
       BOTHRESH(5) BOQNAME('MBK.FPS.RESPONSE.BACKOUT') +
       REPLACE
DEFINE QLOCAL('MBK.FPS.RESPONSE.BACKOUT') +
       DESCR('FPS RESPONSES THAT FAILED 5 TIMES - PAYMENTS OPS') +
       DEFPSIST(YES) MAXDEPTH(10000) +
       QDEPTHHI(1) QDPHIEV(ENABLED) REPLACE
DEFINE PROCESS('MBK.PYFR.PROCESS') +
       DESCR('START CICS TRANSACTION PYFR IN CICSPRD1') +
       APPLTYPE(CICS) APPLICID('PYFR') REPLACE
*
* ---- MQ-CICS DPL BRIDGE (ALTERNATIVE CHANNEL ENTRY TO CHROUTER) ---
DEFINE QLOCAL('MBK.CICS.BRIDGE.REQ') +
       DESCR('DPL BRIDGE REQUESTS FOR CHROUTER - CKBR MONITOR') +
       DEFPSIST(NO) MAXDEPTH(20000) SHARE +
       REPLACE
DEFINE QLOCAL('MBK.CICS.BRIDGE.REPLY') +
       DESCR('DPL BRIDGE REPLIES') +
       DEFPSIST(NO) MAXDEPTH(20000) REPLACE
*
* ---- MQ-CICS DPL BRIDGE - CARD AUTHORISATION GATEWAY (STANDBY) ---
* THE CARD GATEWAY NORMALLY CALLS CHROUTER OVER IPIC (CONNECTION
* MBKCARD, MIRROR CHMC, TCLASS MBKCRD - CSD GROUP MBKCOR2). IF THE
* IPIC LINK IS DOWN IT FAILS OVER TO THESE QUEUES (CLIENT CHANNEL
* CARDGW.SVRCONN, DEFINED BY THE MIDDLEWARE TEAM). A SEPARATE
* REQUEST QUEUE AND BRIDGE MONITOR (CKBR STARTED WITH
* Q=MBK.CARD.BRIDGE.REQ) KEEP CARD TRAFFIC OUT OF THE IBANK QUEUE.
* THE GATEWAY SETS EXPIRY 50 (5 SECONDS) - IT STANDS IN AFTER THAT,
* SO AN EXPIRED REQUEST MUST NOT BE PROCESSED LATE AND PLACE A HOLD.
* NON-PERSISTENT: A LOST AUTHORISATION IS RETRIED OR STOOD IN.
DEFINE QLOCAL('MBK.CARD.BRIDGE.REQ') +
       DESCR('CARD AUTH DPL BRIDGE REQUESTS - STANDBY ROUTE') +
       DEFPSIST(NO) MAXDEPTH(5000) MAXMSGL(4096) SHARE +
       BOTHRESH(1) BOQNAME('MBK.CARD.BRIDGE.BACKOUT') +
       QDEPTHHI(20) QDPHIEV(ENABLED) REPLACE
DEFINE QLOCAL('MBK.CARD.BRIDGE.REPLY') +
       DESCR('CARD AUTH DPL BRIDGE REPLIES - READ BY CARD GW') +
       DEFPSIST(NO) MAXDEPTH(5000) MAXMSGL(4096) REPLACE
DEFINE QLOCAL('MBK.CARD.BRIDGE.BACKOUT') +
       DESCR('CARD AUTH REQUESTS THAT FAILED - CARD OPS') +
       DEFPSIST(NO) MAXDEPTH(5000) +
       QDEPTHHI(1) QDPHIEV(ENABLED) REPLACE
*
* ---- FX RATE FIXING FILE (NO MQ OBJECTS) --------------------------
* GROUP TREASURY'S FIXING FILE ARRIVES BY CONNECT:DIRECT AS
* MBK.PRD.FX.FIXING(+1). ITS CREATION IS THE CA-7 DATASET TRIGGER
* (EVENT FXFIX) FOR JOB FXRAT01 - NO MQ TRIGGER QUEUE IS NEEDED.
* CICS SEES NEW RATES ON THE NEXT READ OF FILE FXRATES (NSR, NOT
* LSR - SEE CSD MBKCOR2), SO NO REFRESH MESSAGE IS SENT EITHER.
*
* ---- TRANSMISSION QUEUE TO THE GATEWAY ----------------------------
DEFINE QLOCAL('PGWP1') USAGE(XMITQ) +
       DESCR('XMITQ TO PAYMENTS GATEWAY QMGR PGWP1') +
       TRIGGER TRIGTYPE(FIRST) INITQ('SYSTEM.CHANNEL.INITQ') +
       TRIGDATA('MQP1.TO.PGWP1') MAXDEPTH(200000) REPLACE
