)CM ******************************************************************
)CM SKELETON : CFDEC01S
)CM TITLE    : BEREAVEMENT - LATE RUN OUTSIDE CA-7 (OPERATIONS ONLY)
)CM BASED ON : MBK.PRD.JCL(CFDEC01) - KEEP IN STEP
)CM CALLED BY: MBKSUBMT (ADM LEVEL R OVERRIDE REQUIRED)
)CM ------------------------------------------------------------------
)CM USED WHEN CFDEC01 FAILED AT 19:00 AND MUST RUN BEFORE PSEOD01
)CM (DECPOST IS PICKED UP BY TONIGHT'S POSTING RUN). MUST NOT BE RUN
)CM AFTER PSEOD01 HAS STARTED - OPERATIONS CHECK CA-7 (LQ,JOB=PSEOD01)
)CM BEFORE SUBMITTING. THE JOB IS SUBMITTED TYPRUN=HOLD BY DEFAULT
)CM (SHOLD) SO THE CHECK CAN BE MADE BEFORE IT IS RELEASED.
)CM CFDEC010 IS NOT RERUNNABLE AFTER A SUCCESSFUL RUN: NOTIFICATIONS
)CM WOULD BE REJECTED ("CIF ALREADY DECEASED") BUT PROBATE PAY-OUTS
)CM WOULD BE MADE AGAIN. OPERATIONS MUST CHECK THE DEC1 REPORT FIRST.
)CM ------------------------------------------------------------------
)CM 2013-01-21 PDQ  ORIGINAL
)CM ******************************************************************
)SET SDB2 = N
)IM MBKJOBC
//*------------------------------------------------------------------*
//* CFDEC01 LATE RUN - BEREAVEMENT INSTRUCTIONS
//*------------------------------------------------------------------*
//* DE010 - BEREAVEMENT INSTRUCTIONS (CFDEC010)
//*------------------------------------------------------------------*
//DE010    EXEC MBKBATCH,PGM=CFDEC010,HLQ='&SHLQ'
//STEP.BEREAVE  DD DISP=SHR,DSN=&SHLQ..CIF.BEREAVE.IN(0)
//STEP.CIFMAST  DD DISP=OLD,DSN=&SHLQ..CIF.MASTER
//STEP.ACCTMAST DD DISP=OLD,DSN=&SHLQ..DDA.ACCTMAST
//STEP.ACCTMAS1 DD DISP=SHR,DSN=&SHLQ..DDA.ACCTMAST.CIFPATH
//STEP.SOMAST   DD DISP=OLD,DSN=&SHLQ..SO.MASTER
//STEP.DDMAND   DD DISP=OLD,DSN=&SHLQ..DDM.MANDATE
//STEP.LOANMAST DD DISP=OLD,DSN=&SHLQ..LOAN.MASTER
//STEP.LOANMAS1 DD DISP=SHR,DSN=&SHLQ..LOAN.MASTER.CIFPATH
//STEP.DECPOST  DD DSN=&SHLQ..PST.FEED.DECPOST,
//            DISP=(MOD,CATLG,CATLG),UNIT=SYSDA,
//            SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//STEP.PAYOUT   DD DSN=&SHLQ..CIF.BEREAVE.PAYOUT(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//STEP.LETTERS  DD DSN=&SHLQ..CIF.BEREAVE.LETTERS(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=250,BLKSIZE=0)
//STEP.REPORT   DD SYSOUT=(R,,DEC1),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
