/* REXX ***************************************************************/
/* EXEC     : MBKCGREF                                                */
/* TITLE    : CHARGE REFUNDS - REQUEST, DUAL APPROVAL, CUT-OFF        */
/* LIBRARY  : MBK.PRD.REXX                                            */
/* INVOKE   : MBKMENU OPTION 4 (CUSTOMER RELATIONS / COMPLAINTS)      */
/*            %MBKCGREF APPROVE  (MBKMENU OPTION A)                   */
/*            %MBKCGREF RELEASE  (MBKMENU OPTION R)                   */
/* PANELS   : MBKCGR1  REFUND REQUEST                                 */
/*            MBKCGR2  APPROVAL LIST                                  */
/*            MBKCGR3  RELEASE CONFIRMATION                           */
/*            MBKREJ1  REJECTION REASON (SHARED)                      */
/*            MBKCGRH  HELP                                           */
/* BATCH    : CGREF01 / CGREF010 (CA-7 MBKEOD, AFTER CGCHG01)         */
/*--------------------------------------------------------------------*/
/* OUTPUT   : <HLQ>.CHG.REFUNDS.APPROVED(+1)  FB 120  (DD REFUNDIN)   */
/*            LAYOUT CGREF010 WS-REFUND-REQUEST:                      */
/*  COLS   1-6   RFQ-SORT-CODE        COLS  44-47  RFQ-REASON-CD      */
/*  COLS   7-14  RFQ-ACCT-NO          COLS  48-55  RFQ-REQUEST-USER   */
/*  COLS  15-22  RFQ-PERIOD-END       COLS  56-63  RFQ-APPROVE-USER   */
/*  COLS  23-26  RFQ-CHARGE-TYPE      COLS  64-75  RFQ-CASE-REF       */
/*  COLS  27-32  RFQ-ITEM-SEQ         COLS  76-110 RFQ-NARRATIVE      */
/*  COLS  33-43  RFQ-AMOUNT 9(9)V99   COLS 111-120 FILLER             */
/*               (ZONED, IMPLIED DECIMAL - 25.00 = 00000002500)       */
/*--------------------------------------------------------------------*/
/* CONTROLS (CUSTOMER RELATIONS PROCEDURE CR-PROC-11) - ALSO APPLIED  */
/* BY CGREF010, BUT CHECKED HERE SO THE CUSTOMER IS NOT TOLD "DONE"   */
/* AND THEN REJECTED OVERNIGHT:                                       */
/*   - REQUESTER AND APPROVER DIFFERENT (FOUR EYES)                   */
/*   - OVER 250.00, OR AMOUNT ZERO ("REMAINING BALANCE" - WE DO NOT   */
/*     KNOW HOW MUCH THAT IS), THE APPROVER MUST BE LEVEL 2. THE      */
/*     LEVEL 2 LIST BELOW MUST MATCH CGREF010 WS-L2-APPROVERS OR THE  */
/*     PROGRAM WILL REJECT WHAT WE APPROVED (PIR 2008/150).           */
/*   - REASON CODE GDWL CMPL BERR FOSD HARD                           */
/*   - FOSD (OMBUDSMAN) NEEDS THE FOS CASE REFERENCE                  */
/*   - HARD (HARDSHIP) NEEDS A COLLECTIONS REFERRAL CASE REF          */
/*                                                                    */
/* CUT-OFF: CGREF01 READS ONLY THE CURRENT GENERATION. RELEASE        */
/* WRITES ONE GENERATION PER BUSINESS DAY - A SECOND RELEASE ON THE   */
/* SAME DAY MERGES WITH THE FIRST. THE LAST RELEASE DATE IS KEPT IN   */
/* THE HEADER OF MEMBER RELCTL OF THE PENDING LIBRARY. NO RELEASE     */
/* BETWEEN 21:30 AND 05:30 (MBKEOD RUNNING, DATE NOT YET ROLLED).     */
/*--------------------------------------------------------------------*/
/* 2007-08-20 JNB  ORIGINAL (OFT TEST CASE RECLAIMS)                  */
/* 2008-04-07 JNB  LEVEL 2 APPROVERS ABOVE 250.00                     */
/* 2009-11-02 AOS  OUTPUT TO GDG (WAS DISP=MOD ON A FLAT FILE THAT    */
/*                 WAS NEVER EMPTIED - REFUNDS PAID TWICE, INC        */
/*                 2009/0731)                                         */
/* 2013-01-21 PDQ  PENDING QUEUE VIA MBKPEND, RELEASE OPTION          */
/* 2015-03-02 PDQ  FOSD / HARD CASE REFERENCE CHECKS (FCA DISP)       */
/**********************************************************************/
TRACE O
NUMERIC DIGITS 18
PARSE UPPER ARG MODE .
IF MODE = '' THEN MODE = 'NEW'
FUNC = 'CGR'

IF SYSVAR('SYSISPF') <> 'ACTIVE' THEN DO
   SAY 'MBKCGREF - RUN FROM THE MBKMENU DIALOG'
   EXIT 12
END
ADDRESS ISPEXEC
"CONTROL ERRORS RETURN"
"VGET (MBKHLQ MBKBDATE) SHARED"
IF MBKHLQ = '' | MBKBDATE = '' THEN DO
   CALL MSG 'START FROM MBKMENU', 'MBKCGREF MUST BE STARTED FROM',
      'MBKMENU'
   EXIT 12
END
OUTDSN  = MBKHLQ'.CHG.REFUNDS.APPROVED'
USER    = USERID()
L2LIMIT = 250.00
/* KEEP IN STEP WITH CGREF010 WS-L2-APPROVER-VALUES */
L2USERS = 'CRTL0001 CRTL0002 CRTL0004 CRTL0007 CRMGR001 CRMGR002'
REASONS = 'GDWL CMPL BERR FOSD HARD'
CUTOFF_FROM = '2130'
CUTOFF_TO   = '0530'

SELECT
   WHEN MODE = 'NEW'     THEN CALL NEW_REQUEST
   WHEN MODE = 'APPROVE' THEN CALL APPROVE_LIST
   WHEN MODE = 'RELEASE' THEN CALL RELEASE
   OTHERWISE CALL MSG 'INVALID MODE', 'MBKCGREF - MODE' MODE
END
EXIT 0

/*====================================================================*/
/* NEW REFUND REQUEST                                                 */
/*====================================================================*/
NEW_REQUEST:
   IF MBKAUTH('CHECK', FUNC, 'K') <> 0 THEN DO
      CALL AUDIT 'DENIED', '', 'REFUND REQUEST - NO LEVEL K'
      CALL MSG 'NOT AUTHORISED', 'YOU ARE NOT AUTHORISED TO REQUEST',
         'CHARGE REFUNDS.'
      RETURN
   END
   CRSORT = ''; CRACCT = ''; CRPEND = ''; CRTYPE = ''; CRSEQ = ''
   CRAMT = ''; CRRSN = ''; CRCASE = ''; CRNARR = ''; CRNOTE = ''
   SAVED = 0
   DO FOREVER
      "DISPLAY PANEL(MBKCGR1)"
      IF RC >= 8 THEN LEAVE
      E = VALIDATE_REQUEST()
      IF E <> '' THEN DO
         CALL MSG 'NOT SAVED', E
         ITERATE
      END
      IF SAVE_REQUEST() = 0 THEN DO
         SAVED = SAVED + 1
         /* KEEP THE ACCOUNT AND CASE - COMPLAINTS USUALLY COVER    */
         /* SEVERAL CHARGES ON THE SAME ACCOUNT                     */
         CRPEND = ''; CRTYPE = ''; CRSEQ = ''; CRAMT = ''
      END
   END
   IF SAVED > 0 THEN CALL MSG SAVED 'REQUEST(S) SAVED', SAVED,
      'REFUND REQUEST(S) ARE WAITING FOR A SECOND USER TO APPROVE.'
   RETURN

VALIDATE_REQUEST:
   CRNOTE = ''
   IF \DATATYPE(CRSORT,'W') | LENGTH(CRSORT) <> 6 THEN,
      RETURN 'SORT CODE IS 6 DIGITS.'
   IF \DATATYPE(CRACCT,'W') | LENGTH(CRACCT) <> 8 THEN,
      RETURN 'ACCOUNT NUMBER IS 8 DIGITS.'
   IF \MODULUS_OK(CRSORT, CRACCT) THEN,
      RETURN 'SORT CODE / ACCOUNT FAILS THE MODULUS CHECK.'
   IF \VALID_DATE(CRPEND) THEN,
      RETURN 'CHARGE PERIOD END MUST BE A VALID CCYYMMDD DATE.'
   IF CRPEND > MBKBDATE THEN,
      RETURN 'CHARGE PERIOD END CANNOT BE IN THE FUTURE.'
   IF DATE('B', MBKBDATE, 'S') - DATE('B', CRPEND, 'S') > 6 * 366,
      THEN RETURN 'CHARGES OVER 6 YEARS OLD ARE NOT HELD -',
         'REFER TO COMPLAINTS LEDGER (LIMITATION ACT).'
   CRTYPE = TRANSLATE(STRIP(CRTYPE))
   IF LENGTH(CRTYPE) <> 4 | \DATATYPE(CRTYPE,'A') THEN,
      RETURN 'CHARGE TYPE IS THE 4-CHARACTER CODE FROM CHARGE HISTORY.'
   IF \DATATYPE(CRSEQ,'W') | CRSEQ < 1 | CRSEQ > 999999 THEN,
      RETURN 'ITEM SEQUENCE IS 1-999999 (FROM CHARGE HISTORY).'
   V = SPACE(TRANSLATE(CRAMT,' ',','),0)
   IF V = '' THEN V = 0
   IF \DATATYPE(V,'N') | V < 0 | VERIFY(V,'0123456789.') > 0 THEN,
      RETURN 'AMOUNT MUST BE 0 (REMAINING BALANCE) OR A POSITIVE',
         'AMOUNT.'
   IF DECS(V) > 2 THEN RETURN 'AMOUNT HAS AT MOST 2 DECIMALS.'
   IF V > 999999999.99 THEN RETURN 'AMOUNT TOO LARGE.'
   CRAMT = FORMAT(V,,2)
   IF WORDPOS(CRRSN, REASONS) = 0 THEN,
      RETURN 'REASON MUST BE ONE OF' REASONS'.'
   CRCASE = TRANSLATE(STRIP(CRCASE))
   IF CRRSN = 'FOSD' & LEFT(CRCASE,3) <> 'FOS' THEN,
      RETURN 'OMBUDSMAN DECISIONS NEED THE FOS CASE REF (FOS...).'
   IF CRRSN = 'HARD' & LEFT(CRCASE,3) <> 'COL' THEN,
      RETURN 'HARDSHIP REFUNDS NEED THE COLLECTIONS REFERRAL (COL...).'
   IF CRRSN = 'CMPL' & CRCASE = '' THEN,
      RETURN 'COMPLAINT REFUNDS NEED THE COMPLAINT CASE REFERENCE.'
   IF STRIP(CRNARR) = '' THEN,
      RETURN 'NARRATIVE REQUIRED - IT APPEARS ON THE STATEMENT.'
   IF CRAMT = 0 | CRAMT > L2LIMIT THEN,
      CRNOTE = 'NEEDS A LEVEL 2 APPROVER'
   /* DUPLICATE OF A REQUEST ALREADY QUEUED? */
   IF DUP_CHECK() THEN,
      RETURN 'A REFUND FOR THIS CHARGE IS ALREADY WAITING (' DUPREF ').'
   RETURN ''

MAKE_CARD:
   C = RIGHT(CRSORT, 6, '0')                 ||,  /*   1-6   SORT  */
       RIGHT(CRACCT, 8, '0')                 ||,  /*   7-14  ACCT  */
       RIGHT(CRPEND, 8, '0')                 ||,  /*  15-22  PEND  */
       LEFT(CRTYPE, 4)                       ||,  /*  23-26  TYPE  */
       RIGHT(CRSEQ, 6, '0')                  ||,  /*  27-32  SEQ   */
       RIGHT(TRUNC(CRAMT * 100), 11, '0')    ||,  /*  33-43  AMT   */
       LEFT(CRRSN, 4)                        ||,  /*  44-47  RSN   */
       LEFT(USER, 8)                         ||,  /*  48-55  REQ   */
       LEFT('', 8)                           ||,  /*  56-63  APPR  */
       LEFT(CRCASE, 12)                      ||,  /*  64-75  CASE  */
       LEFT(CRNARR, 35)                      ||,  /*  76-110 NARR  */
       LEFT('', 10)                               /* 111-120       */
   RETURN C

SAVE_REQUEST:
   CARD = MAKE_CARD()
   IF LENGTH(CARD) <> 120 THEN DO
      CALL MSG 'INTERNAL ERROR', 'CARD LENGTH' LENGTH(CARD)
      RETURN 8
   END
   MEM = MBKPEND('NEWMEM', FUNC, 'P')
   IF MEM = '' THEN RETURN 8
   CREF = 'F'SUBSTR(DATE('S'),3,4)SUBSTR(MEM,2,7)
   HDR = LEFT('*PEND',6)LEFT(FUNC,4)LEFT(CREF,13)LEFT(USER,9),
      || LEFT(DATE('S'),9)LEFT(SPACE(TRANSLATE(TIME('N'),' ',':'),0),7),
      || LEFT('',9)LEFT(CRSORT CRACCT CRAMT, 23)
   QUEUE CARD
   IF MBKPEND('WRITE', FUNC, MEM, HDR) <> 0 THEN RETURN 8
   CALL AUDIT 'REQUEST', CREF, CRSORT CRACCT CRTYPE CRSEQ 'AMT',
      CRAMT CRRSN 'CASE' CRCASE
   CALL MSG 'SAVED' CREF, 'REFUND' CREF 'OF' CRAMT 'SAVED FOR',
      'APPROVAL.' CRNOTE
   RETURN 0

/* SAME ACCOUNT, PERIOD, TYPE AND SEQUENCE ALREADY IN THE QUEUE */
DUP_CHECK:
   DUPREF = ''
   KEYNEW = RIGHT(CRSORT,6,'0')RIGHT(CRACCT,8,'0')RIGHT(CRPEND,8,'0'),
      || LEFT(CRTYPE,4)RIGHT(CRSEQ,6,'0')
   N = MBKPEND('LIST', FUNC, '*')
   IF \DATATYPE(N,'W') | N < 1 THEN RETURN 0
   DO I = 1 TO N; PARSE PULL DM.I; END
   DO I = 1 TO N
      IF LEFT(DM.I,1) <> 'P' & LEFT(DM.I,1) <> 'A' THEN ITERATE
      C = MBKPEND('READ', FUNC, DM.I)
      IF C < 1 THEN ITERATE
      PARSE PULL H
      PARSE PULL D
      DO C - 1; PULL .; END
      IF LEFT(D, 32) = KEYNEW THEN DO
         DUPREF = STRIP(SUBSTR(H, 11, 12))
         RETURN 1
      END
   END
   RETURN 0

/*====================================================================*/
/* APPROVAL                                                           */
/*====================================================================*/
APPROVE_LIST:
   LV = MBKAUTH('LEVELS', FUNC)
   IF VERIFY(LV, 'A2', 'M') = 0 THEN DO
      CALL AUDIT 'DENIED', '', 'REFUND APPROVAL - NO LEVEL A/2'
      CALL MSG 'NOT AUTHORISED', 'YOU ARE NOT A REFUND APPROVER.'
      RETURN
   END
   IS_L2 = (POS('2', LV) > 0) & (WORDPOS(USER, L2USERS) > 0)
   IF POS('2', LV) > 0 & WORDPOS(USER, L2USERS) = 0 THEN,
      CALL MSG 'LEVEL 2 MISMATCH', 'YOU HAVE LEVEL 2 IN THE DIALOG',
         'TABLE BUT ARE NOT IN CGREF010 WS-L2-APPROVERS - YOU CAN',
         'ONLY APPROVE UP TO' L2LIMIT'. RAISE A CR WITH CORE SYSTEMS.'
   DO FOREVER
      "TBCREATE CGRAPPR NOWRITE REPLACE",
         "NAMES(ASEL AMEM AREF AUSER ADATE ASORT AACCT ATYPE AAMT",
         "ARSN ACASE ANARR AL2)"
      N = MBKPEND('LIST', FUNC, 'P*')
      IF \DATATYPE(N,'W') | N < 0 THEN RETURN
      DO I = 1 TO N; PARSE PULL M.I; END
      DO I = 1 TO N
         AMEM = M.I
         IF READ_ITEM(AMEM) <> 0 THEN ITERATE
         AREF = IREF; AUSER = IREQ; ADATE = IDATE
         PARSE VAR ICARD 1 ASORT 7 AACCT 15 . 23 ATYPE 27 . 33 AAMT,
            44 ARSN 48 . 64 ACASE 76 ANARR 111 .
         AAMT = FORMAT(AAMT / 100,,2)
         IF AAMT = 0 THEN AAMT = 'BALANCE'
         AL2 = ''
         IF AAMT = 'BALANCE' THEN AL2 = 'L2'
         ELSE IF AAMT > L2LIMIT THEN AL2 = 'L2'
         ASEL = ''
         "TBADD CGRAPPR"
      END
      "TBSORT CGRAPPR FIELDS(ADATE,C,A)"
      "TBTOP CGRAPPR"
      ACOUNT = N
      "TBDISPLAY CGRAPPR PANEL(MBKCGR2)"
      IF RC >= 8 THEN DO
         "TBEND CGRAPPR"
         RETURN
      END
      DO WHILE ZTDSELS > 0
         SEL = TRANSLATE(ASEL)
         SELECT
            WHEN SEL = 'A' THEN CALL APPROVE_ITEM AMEM
            WHEN SEL = 'R' THEN CALL REJECT_ITEM AMEM
            OTHERWISE NOP
         END
         IF ZTDSELS > 1 THEN "TBDISPLAY CGRAPPR"
         ELSE ZTDSELS = 0
      END
      "TBEND CGRAPPR"
   END
   RETURN

APPROVE_ITEM:
   PARSE ARG IMEM
   IF READ_ITEM(IMEM) <> 0 THEN RETURN
   FE = MBKAUTH('FOUREYES', FUNC, IREQ)
   IF FE <> 0 THEN DO
      IF FE = 4 THEN T = 'YOU REQUESTED' IREF '- A DIFFERENT USER',
         'MUST APPROVE IT (CR-PROC-11).'
      ELSE T = 'YOU ARE NOT A REFUND APPROVER.'
      CALL AUDIT 'DENIED', IREF, 'APPROVE - FOUREYES RC' FE
      CALL MSG 'CANNOT APPROVE', T
      RETURN
   END
   AMT = SUBSTR(ICARD, 33, 11) / 100
   IF (AMT = 0 | AMT > L2LIMIT) & \IS_L2 THEN DO
      CALL AUDIT 'DENIED', IREF, 'APPROVE' AMT '- NOT LEVEL 2'
      CALL MSG 'LEVEL 2 REQUIRED', IREF 'IS OVER' L2LIMIT 'OR FOR THE',
         'REMAINING BALANCE - A TEAM LEADER (LEVEL 2) MUST APPROVE.'
      RETURN
   END
   IF SUBSTR(ICARD,48,8) <> LEFT(IREQ,8) |,
      SUBSTR(ICARD,56,8) <> '' THEN DO
      CALL AUDIT 'ERROR', IREF, 'MEMBER' IMEM 'ALTERED'
      CALL MSG 'ITEM INVALID', IREF 'WAS ALTERED OUTSIDE THE DIALOG',
         '- REJECT IT AND REPORT TO SECURITY.'
      RETURN
   END
   ICARD = OVERLAY(LEFT(USER,8), ICARD, 56)
   IHDR  = OVERLAY(LEFT(USER,8), IHDR, 49)
   QUEUE ICARD
   IF MBKPEND('WRITE', FUNC, 'A'SUBSTR(IMEM,2), IHDR) <> 0 THEN RETURN
   IF MBKPEND('DELETE', FUNC, IMEM) <> 0 THEN DO
      CALL AUDIT 'ERROR', IREF, 'P MEMBER' IMEM 'NOT DELETED'
      RETURN
   END
   CALL AUDIT 'APPROVE', IREF, 'AMT' FORMAT(AMT,,2) 'REQUESTED BY',
      IREQ
   "TBDELETE CGRAPPR"
   CALL TELL IREQ, 'MBK: REFUND' IREF 'APPROVED BY' USER
   CALL MSG IREF 'APPROVED', 'REFUND' IREF 'APPROVED. IT GOES TO',
      'TONIGHT''S CGREF01 AT THE CUT-OFF RELEASE.'
   RETURN

REJECT_ITEM:
   PARSE ARG IMEM
   IF READ_ITEM(IMEM) <> 0 THEN RETURN
   RJKEY = IREF; RJTEXT = ''
   "ADDPOP ROW(6) COLUMN(10)"
   "DISPLAY PANEL(MBKREJ1)"
   PRC = RC
   "REMPOP"
   IF PRC >= 8 THEN RETURN
   IF MBKPEND('DELETE', FUNC, IMEM) <> 0 THEN RETURN
   CALL AUDIT 'REJECT', IREF, RJTEXT
   "TBDELETE CGRAPPR"
   CALL TELL IREQ, 'MBK: REFUND' IREF 'REJECTED -' LEFT(RJTEXT,40)
   CALL MSG IREF 'REJECTED', 'REFUND' IREF 'REJECTED AND REMOVED.'
   RETURN

READ_ITEM:
   PARSE ARG RMEM
   C = MBKPEND('READ', FUNC, RMEM)
   IF \DATATYPE(C,'W') | C < 1 THEN DO
      CALL MSG 'NOT FOUND', 'MEMBER' RMEM 'IS EMPTY OR WAS PROCESSED',
         'BY ANOTHER USER.'
      RETURN 8
   END
   PARSE PULL IHDR
   PARSE PULL ICARD
   DO C - 1; PULL .; END
   PARSE VAR IHDR 11 IREF 23 . 24 IREQ 32 . 33 IDATE 41 .
   IREF = STRIP(IREF); IREQ = STRIP(IREQ)
   RETURN 0

/*====================================================================*/
/* CUT-OFF RELEASE                                                    */
/*====================================================================*/
RELEASE:
   IF MBKAUTH('CHECK', FUNC, 'R') <> 0 THEN DO
      CALL AUDIT 'DENIED', '', 'RELEASE - NO LEVEL R'
      CALL MSG 'NOT AUTHORISED', 'RELEASE NEEDS LEVEL R.'
      RETURN
   END
   NOW = SPACE(TRANSLATE(LEFT(TIME('N'),5),' ',':'),0)
   IF NOW >= CUTOFF_FROM | NOW < CUTOFF_TO THEN DO
      CALL MSG 'AFTER CUT-OFF', 'RELEASE IS NOT ALLOWED BETWEEN',
         '21:30 AND 05:30 - THE ITEMS WILL GO TOMORROW.'
      RETURN
   END
   N = MBKPEND('LIST', FUNC, 'A*')
   IF \DATATYPE(N,'W') | N < 0 THEN RETURN
   IF N = 0 THEN DO
      CALL MSG 'NOTHING TO RELEASE', 'NO APPROVED REFUNDS ARE WAITING.'
      RETURN
   END
   DO I = 1 TO N; PARSE PULL RM.I; END
   NEWC.0 = 0
   RLTOTAL = 0
   DO I = 1 TO N
      IF READ_ITEM(RM.I) <> 0 THEN ITERATE
      IF SUBSTR(ICARD,56,8) = '' THEN ITERATE
      K = NEWC.0 + 1
      NEWC.K = ICARD
      NEWM.K = RM.I
      NEWC.0 = K
      RLTOTAL = RLTOTAL + SUBSTR(ICARD,33,11) / 100
   END
   RLCOUNT = NEWC.0
   RLTOTAL = FORMAT(RLTOTAL,,2)
   RLLAST = LAST_RELEASE()
   RLMERGE = 'N'
   IF RLLAST = MBKBDATE THEN RLMERGE = 'Y'
   RLCONF = ''
   "DISPLAY PANEL(MBKCGR3)"
   IF RC >= 8 | RLCONF <> 'Y' THEN RETURN

   ALL.0 = 0
   IF RLMERGE = 'Y' THEN DO
      CALL OUTTRAP 'X.'
      ADDRESS TSO "ALLOC F(CGROLD) DA('"OUTDSN"(0)') OLD REUSE"
      ARC = RC
      CALL OUTTRAP 'OFF'
      IF ARC <> 0 THEN DO
         CALL MSG 'IN USE', OUTDSN'(0) IS IN USE - TRY AGAIN.'
         RETURN
      END
      ADDRESS TSO "EXECIO * DISKR CGROLD (STEM ALL. FINIS"
      ADDRESS TSO "FREE F(CGROLD)"
   END
   BASE = ALL.0
   DO I = 1 TO NEWC.0
      K = ALL.0 + 1
      ALL.K = NEWC.I
      ALL.0 = K
   END
   ADDRESS TSO "ALLOC F(CGRNEW) DA('"OUTDSN"(+1)') NEW CATALOG",
      "UNIT(SYSDA) SPACE(1 1) TRACKS RELEASE",
      "RECFM(F B) LRECL(120) BLKSIZE(0) REUSE"
   IF RC <> 0 THEN DO
      CALL MSG 'ALLOCATION FAILED', 'CANNOT CREATE' OUTDSN'(+1)'
      RETURN
   END
   ADDRESS TSO "EXECIO" ALL.0 "DISKW CGRNEW (STEM ALL. FINIS"
   WRC = RC
   X = LISTDSI('CGRNEW' 'FILE')
   GEN = SYSDSNAME
   ADDRESS TSO "FREE F(CGRNEW)"
   IF WRC <> 0 THEN DO
      CALL AUDIT 'ERROR', '', 'RELEASE WRITE' GEN 'RC='WRC
      CALL MSG 'WRITE FAILED', 'WRITE TO' GEN 'FAILED RC='WRC
      RETURN
   END
   DO I = 1 TO NEWC.0
      CALL MBKPEND 'DELETE', FUNC, NEWM.I
   END
   CALL SET_LAST_RELEASE RIGHT(GEN,8)
   CALL AUDIT 'RELEASE', RIGHT(GEN,8), NEWC.0 'REFUND(S) TOTAL',
      RLTOTAL '(+'BASE 'ALREADY RELEASED TODAY)'
   CALL MSG 'RELEASED', NEWC.0 'REFUND(S) TOTALLING' RLTOTAL,
      'WRITTEN TO' GEN 'FOR TONIGHT''S CGREF01.'
   RETURN

/* RELCTL MEMBER: HEADER COLS 58-65 = LAST RELEASE BUSINESS DATE */
LAST_RELEASE:
   C = MBKPEND('READ', FUNC, 'RELCTL')
   IF C < 0 THEN RETURN ''
   PARSE PULL H
   DO C; PULL .; END
   RETURN STRIP(SUBSTR(H, 58, 8))

SET_LAST_RELEASE:
   PARSE ARG G
   H = LEFT('*PEND',6)LEFT(FUNC,4)LEFT('RELCTL',13)LEFT(USER,9),
      || LEFT(DATE('S'),9)LEFT(SPACE(TRANSLATE(TIME('N'),' ',':'),0),7),
      || LEFT('',9)LEFT(MBKBDATE G, 23)
   CALL MBKPEND 'WRITE', FUNC, 'RELCTL', H
   RETURN

/*====================================================================*/
/* UTILITIES                                                          */
/*====================================================================*/
/* VOCALINK STANDARD MODULUS 11 FOR MEGABANK SORT CODES 40-XX-XX; */
/* OTHER SORT CODES ARE NOT OURS AND CANNOT HAVE OUR CHARGES     */
MODULUS_OK: PROCEDURE
   PARSE ARG S, A
   IF LEFT(S,2) <> '40' THEN RETURN 0
   W = '0 0 0 0 0 0 7 1 3 7 1 3 7 1'
   D = S || A
   T = 0
   DO I = 1 TO 14
      T = T + SUBSTR(D, I, 1) * WORD(W, I)
   END
   RETURN (T // 10 = 0) | (T // 11 = 0)

TELL: PROCEDURE
   PARSE ARG U, T
   IF U = USERID() THEN RETURN
   CALL OUTTRAP 'X.'
   ADDRESS TSO "SEND '"LEFT(T,70)"' USER("STRIP(U)") LOGON"
   CALL OUTTRAP 'OFF'
   RETURN

DECS: PROCEDURE
   PARSE ARG N
   IF POS('.', N) = 0 THEN RETURN 0
   RETURN LENGTH(STRIP(SUBSTR(N, POS('.', N) + 1), 'T', '0'))

VALID_DATE: PROCEDURE
   PARSE ARG D
   IF \DATATYPE(D,'W') | LENGTH(D) <> 8 THEN RETURN 0
   Y = LEFT(D,4); M = SUBSTR(D,5,2); DD = RIGHT(D,2)
   IF Y < 1900 | M < 1 | M > 12 | DD < 1 THEN RETURN 0
   ML = WORD('31 28 31 30 31 30 31 31 30 31 30 31', M)
   IF M = 2 & (Y // 4 = 0 & (Y // 100 <> 0 | Y // 400 = 0)) THEN,
      ML = 29
   RETURN DD <= ML

AUDIT:
   PARSE ARG AACT, AKEY, ATXT
   CALL MBKAUDIT 'LOG', FUNC, AACT, AKEY, ATXT
   IF RESULT <> 0 THEN,
      CALL MSG 'AUDIT FAILURE', 'THE AUDIT LOG COULD NOT BE WRITTEN',
         '- STOP AND CALL CORE SYSTEMS SUPPORT.'
   RETURN

MSG: PROCEDURE
   PARSE ARG SHORT, LONG
   ZEDSMSG = SHORT
   ZEDLMSG = LONG
   ADDRESS ISPEXEC "SETMSG MSG(ISRZ001)"
   RETURN
