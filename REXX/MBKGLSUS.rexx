/* REXX ***************************************************************/
/* EXEC     : MBKGLSUS                                                */
/* TITLE    : GL SUSPENSE CLEARING / WRITE-OFF INSTRUCTIONS           */
/* LIBRARY  : MBK.PRD.REXX                                            */
/* INVOKE   : MBKMENU OPTION 5 (FINANCE OPERATIONS)                   */
/*            %MBKGLSUS APPROVE  (OPTION A - WRITE-OFFS ONLY)         */
/*            %MBKGLSUS RELEASE  (OPTION R)                           */
/* PANELS   : MBKGLS1  CLEARING INSTRUCTION (WITH ITEM DETAILS)       */
/*            MBKGLS2  WRITE-OFF APPROVAL LIST                        */
/*            MBKGLS3  RELEASE CONFIRMATION                           */
/*            MBKREJ1  REJECTION REASON (SHARED)                      */
/*            MBKGLSH  HELP                                           */
/* BATCH    : GLSUS01 / GLSUS010 (CA-7 MBKEOD, AFTER GLFEED01)        */
/*--------------------------------------------------------------------*/
/* OUTPUT   : <HLQ>.GL.SUSP.CLEARED(+1)  FB 120  (DD CLEARIN)         */
/*            LAYOUT GLSUS010 WS-CLEAR-INSTRUCTION:                   */
/*  COLS   1-9   CLI-SUSP-ID     9(9)                                 */
/*  COLS  10     CLI-ACTION      C CLEAR  W WRITE-OFF                 */
/*  COLS  11-26  CLI-CLEARING-REF  ORACLE GL MANUAL JOURNAL REF       */
/*  COLS  27-34  CLI-USER                                             */
/*  COLS  35-42  CLI-APPROVER    (WRITE-OFF ONLY - FOUR EYES)         */
/*  COLS  43-102 CLI-NOTES                                            */
/*  COLS 103-120 FILLER                                               */
/*--------------------------------------------------------------------*/
/* THE ITEM IS LOOKED UP IN MBK.GLSUSP (DSNREXX, READ ONLY) SO THE    */
/* USER SEES WHAT THEY ARE CLEARING AND SO THE CHECKS GLSUS010 MAKES  */
/* OVERNIGHT ARE MADE NOW:                                            */
/*   - ITEM EXISTS AND IS OPEN ('O')                                  */
/*   - WRITE-OFF AMOUNT <= 500.00 (GLSUS010 WS-WRITEOFF-MAX) - ABOVE  */
/*     THAT THE FINANCE CONTROLLER WRITES OFF IN ORACLE GL AND THE    */
/*     ITEM IS CLEARED ('C') WITH THAT JOURNAL REF                    */
/*   - WRITE-OFF APPROVED BY A SECOND USER (LEVEL A)                  */
/* IF DB2 IS DOWN (SUNDAY REORG WINDOW) THE INSTRUCTION CAN STILL BE  */
/* KEYED WITH A WARNING - GLSUS010 WILL REJECT IT IF IT IS WRONG.     */
/*                                                                    */
/* CLEARINGS ('C') NEED NO APPROVAL AND GO STRAIGHT TO THE RELEASE    */
/* QUEUE (A-MEMBERS). RELEASE AS MBKCGREF (ONE GENERATION PER         */
/* BUSINESS DAY, MERGED IF RELEASED TWICE).                           */
/*--------------------------------------------------------------------*/
/* 2004-01-12 KLM  ORIGINAL - ISPF EDIT MACRO ON A MODEL MEMBER       */
/* 2008-06-23 KLM  DIALOG, WRITE-OFF WITH FOUR EYES                   */
/* 2010-07-05 JNB  OUTPUT TO GDG FOR GLSUS01                          */
/* 2013-01-21 PDQ  PENDING QUEUE VIA MBKPEND                          */
/* 2016-09-19 PDQ  DSNREXX LOOK-UP OF THE ITEM (IA-16-022 - ITEMS     */
/*                 CLEARED BY ID TYPO)                                */
/**********************************************************************/
TRACE O
NUMERIC DIGITS 18
PARSE UPPER ARG MODE .
IF MODE = '' THEN MODE = 'NEW'
FUNC = 'GLS'

IF SYSVAR('SYSISPF') <> 'ACTIVE' THEN DO
   SAY 'MBKGLSUS - RUN FROM THE MBKMENU DIALOG'
   EXIT 12
END
ADDRESS ISPEXEC
"CONTROL ERRORS RETURN"
"VGET (MBKHLQ MBKBDATE) SHARED"
IF MBKHLQ = '' | MBKBDATE = '' THEN DO
   CALL MSG 'START FROM MBKMENU', 'MBKGLSUS MUST BE STARTED FROM',
      'MBKMENU'
   EXIT 12
END
OUTDSN  = MBKHLQ'.GL.SUSP.CLEARED'
USER    = USERID()
WOMAX   = 500.00
DB2SSID = 'DB2P'
IF MBKHLQ <> 'MBK.PRD' THEN DB2SSID = 'DB2T'
DB2UP   = 0

SELECT
   WHEN MODE = 'NEW'     THEN CALL NEW_INSTRUCTION
   WHEN MODE = 'APPROVE' THEN CALL APPROVE_LIST
   WHEN MODE = 'RELEASE' THEN CALL RELEASE
   OTHERWISE CALL MSG 'INVALID MODE', 'MBKGLSUS - MODE' MODE
END
IF DB2UP THEN ADDRESS DSNREXX "DISCONNECT"
EXIT 0

/*====================================================================*/
/* KEY CLEARING / WRITE-OFF INSTRUCTIONS                              */
/*====================================================================*/
NEW_INSTRUCTION:
   IF MBKAUTH('CHECK', FUNC, 'K') <> 0 THEN DO
      CALL AUDIT 'DENIED', '', 'CLEARING - NO LEVEL K'
      CALL MSG 'NOT AUTHORISED', 'YOU ARE NOT AUTHORISED TO CLEAR',
         'GL SUSPENSE ITEMS.'
      RETURN
   END
   CALL DB2_CONNECT
   GSID = ''; GSACT = 'C'; GSREF = ''; GSNOTE = ''
   CALL CLEAR_ITEM_FIELDS
   KEYED = 0
   LASTID = ''
   DO FOREVER
      "DISPLAY PANEL(MBKGLS1)"
      IF RC >= 8 THEN LEAVE
      GSID = STRIP(GSID)
      /* NEW ID - LOOK IT UP AND REDISPLAY BEFORE ACCEPTING */
      IF GSID <> LASTID THEN DO
         LASTID = GSID
         CALL LOOKUP_ITEM GSID
         IF RESULT = 0 THEN DO
            CALL MSG 'CHECK THE ITEM', 'CONFIRM THE ITEM DETAILS AND',
               'PRESS ENTER AGAIN TO SAVE.'
            ITERATE
         END
         IF RESULT = 8 THEN ITERATE
      END
      E = VALIDATE_INSTRUCTION()
      IF E <> '' THEN DO
         CALL MSG 'NOT SAVED', E
         ITERATE
      END
      IF SAVE_INSTRUCTION() = 0 THEN DO
         KEYED = KEYED + 1
         GSID = ''; GSREF = ''; GSNOTE = ''; GSACT = 'C'
         LASTID = ''
         CALL CLEAR_ITEM_FIELDS
      END
   END
   IF KEYED > 0 THEN CALL MSG KEYED 'SAVED', KEYED 'INSTRUCTION(S)',
      'SAVED. WRITE-OFFS NEED APPROVAL; CLEARINGS GO AT CUT-OFF.'
   RETURN

CLEAR_ITEM_FIELDS:
   GIRDATE = ''; GISRC = ''; GIGL = ''; GIPROD = ''; GITXN = ''
   GIDRCR = ''; GIAMT = ''; GISTAT = ''; GIRSN = ''; GIAGE = ''
   GIWARN = ''
   RETURN

/*--------------------------------------------------------------------*/
/* LOOK UP THE SUSPENSE ITEM. RESULT 0 FOUND, 4 DB2 UNAVAILABLE       */
/* (CONTINUE WITH WARNING), 8 NOT FOUND / INVALID                     */
/*--------------------------------------------------------------------*/
LOOKUP_ITEM:
   PARSE ARG SID
   CALL CLEAR_ITEM_FIELDS
   IF \DATATYPE(SID,'W') | SID < 1 | SID > 999999999 THEN DO
      CALL MSG 'INVALID ID', 'SUSPENSE ID IS A NUMBER UP TO 9 DIGITS.'
      RETURN 8
   END
   IF \DB2UP THEN DO
      GIWARN = 'DB2 UNAVAILABLE - ITEM NOT CHECKED'
      RETURN 4
   END
   SQLSTMT = 'SELECT CHAR(RAISED_DATE, ISO), SOURCE_PGM, SUSP_GL,',
      'PROD_CD, TXN_CODE, DR_CR_IND, CHAR(AMOUNT), SUSP_STATUS,',
      'REASON_CD, DAYS(CURRENT DATE) - DAYS(RAISED_DATE)',
      'FROM MBK.GLSUSP WHERE SUSP_ID = ? WITH UR'
   ADDRESS DSNREXX "EXECSQL DECLARE C1 CURSOR FOR S1"
   ADDRESS DSNREXX "EXECSQL PREPARE S1 FROM :SQLSTMT"
   IF SQLCODE <> 0 THEN SIGNAL SQL_ERROR
   ADDRESS DSNREXX "EXECSQL OPEN C1 USING :SID"
   IF SQLCODE <> 0 THEN SIGNAL SQL_ERROR
   ADDRESS DSNREXX "EXECSQL FETCH C1 INTO :GIRDATE, :GISRC, :GIGL,",
      ":GIPROD, :GITXN, :GIDRCR, :GIAMT, :GISTAT, :GIRSN, :GIAGE"
   FRC = SQLCODE
   ADDRESS DSNREXX "EXECSQL CLOSE C1"
   IF FRC = 100 THEN DO
      CALL MSG 'NOT FOUND', 'SUSPENSE ID' SID 'IS NOT IN MBK.GLSUSP.'
      RETURN 8
   END
   IF FRC <> 0 THEN SIGNAL SQL_ERROR
   GIAMT = FORMAT(GIAMT,,2)
   SELECT
      WHEN GISTAT = 'C' THEN GIWARN = 'ITEM IS ALREADY CLEARED'
      WHEN GISTAT = 'W' THEN GIWARN = 'ITEM IS ALREADY WRITTEN OFF'
      WHEN GIAGE > 90   THEN GIWARN = 'OVER 90 DAYS - AUDIT IA-08-017'
      WHEN GIAGE > 30   THEN GIWARN = 'OVER 30 DAYS - ESCALATED'
      OTHERWISE NOP
   END
   RETURN 0

SQL_ERROR:
   CALL MSG 'DB2 ERROR', 'SQLCODE' SQLCODE 'LOOKING UP' SID '-',
      SQLERRMC '. THE ITEM WAS NOT CHECKED.'
   GIWARN = 'DB2 ERROR' SQLCODE '- ITEM NOT CHECKED'
   RETURN 4

DB2_CONNECT:
   ADDRESS TSO "SUBCOM DSNREXX"
   IF RC <> 0 THEN X = RXSUBCOM('ADD', 'DSNREXX', 'DSNREXX')
   ADDRESS DSNREXX "CONNECT" DB2SSID
   IF RC = 0 & SQLCODE = 0 THEN DB2UP = 1
   ELSE DO
      DB2UP = 0
      CALL MSG 'DB2 UNAVAILABLE', DB2SSID 'IS NOT AVAILABLE - ITEMS',
         'CANNOT BE CHECKED. KEY ONLY IF THE CLEARING CANNOT WAIT.'
   END
   RETURN

VALIDATE_INSTRUCTION:
   IF \DATATYPE(GSID,'W') THEN RETURN 'SUSPENSE ID IS NUMERIC.'
   IF WORDPOS(GSACT, 'C W') = 0 THEN RETURN 'ACTION MUST BE C OR W.'
   GSREF = TRANSLATE(STRIP(GSREF))
   IF GSREF = '' THEN RETURN 'CLEARING REF (ORACLE JOURNAL) REQUIRED.'
   IF GSACT = 'C' & LEFT(GSREF,2) <> 'MJ' THEN,
      RETURN 'A CLEARING REF IS AN ORACLE MANUAL JOURNAL (MJ...).'
   IF GSACT = 'W' & LEFT(GSREF,2) <> 'WO' & LEFT(GSREF,2) <> 'MJ',
      THEN RETURN 'WRITE-OFF REF IS THE WO... FORM OR MJ... JOURNAL.'
   IF STRIP(GSNOTE) = '' THEN RETURN 'NOTES REQUIRED (WHY / WHAT).'
   IF DB2UP & GIRDATE <> '' THEN DO
      IF GISTAT <> 'O' THEN RETURN 'ITEM IS NOT OPEN (STATUS',
         GISTAT').'
      IF GSACT = 'W' & GIAMT > WOMAX THEN,
         RETURN 'WRITE-OFF OVER' WOMAX '- FINANCE CONTROLLER MUST',
            'WRITE OFF IN ORACLE; CLEAR (C) WITH THAT JOURNAL.'
   END
   IF DUP_QUEUED(GSID) THEN RETURN 'THIS ITEM IS ALREADY QUEUED.'
   RETURN ''

MAKE_CARD:
   C = RIGHT(GSID, 9, '0')      ||,   /*   1-9   SUSP-ID          */
       LEFT(GSACT, 1)           ||,   /*  10     ACTION           */
       LEFT(GSREF, 16)          ||,   /*  11-26  CLEARING-REF     */
       LEFT(USER, 8)            ||,   /*  27-34  USER             */
       LEFT('', 8)              ||,   /*  35-42  APPROVER         */
       LEFT(GSNOTE, 60)         ||,   /*  43-102 NOTES            */
       LEFT('', 18)                   /* 103-120 FILLER           */
   RETURN C

SAVE_INSTRUCTION:
   CARD = MAKE_CARD()
   IF LENGTH(CARD) <> 120 THEN RETURN 8
   /* CLEARINGS NEED NO SECOND USER - STRAIGHT TO THE RELEASE QUEUE */
   PFX = 'P'
   IF GSACT = 'C' THEN PFX = 'A'
   MEM = MBKPEND('NEWMEM', FUNC, PFX)
   IF MEM = '' THEN RETURN 8
   GREF = 'G'SUBSTR(DATE('S'),3,4)SUBSTR(MEM,2,7)
   HDR = LEFT('*PEND',6)LEFT(FUNC,4)LEFT(GREF,13)LEFT(USER,9),
      || LEFT(DATE('S'),9)LEFT(SPACE(TRANSLATE(TIME('N'),' ',':'),0),7),
      || LEFT('',9)LEFT(GSID GSACT GIAMT, 23)
   QUEUE CARD
   IF MBKPEND('WRITE', FUNC, MEM, HDR) <> 0 THEN RETURN 8
   CHK = 'CHECKED'
   IF GIRDATE = '' THEN CHK = 'NOT CHECKED (DB2)'
   CALL AUDIT 'REQUEST', GREF, 'ID' GSID 'ACTION' GSACT 'REF' GSREF,
      'AMT' GIAMT CHK
   IF GSACT = 'W' THEN CALL MSG 'SAVED' GREF, 'WRITE-OFF' GREF,
      'SAVED - A SECOND USER MUST APPROVE IT.'
   ELSE CALL MSG 'SAVED' GREF, 'CLEARING' GREF 'SAVED FOR CUT-OFF.'
   RETURN 0

DUP_QUEUED:
   PARSE ARG DID
   DID = RIGHT(DID, 9, '0')
   N = MBKPEND('LIST', FUNC, '*')
   IF \DATATYPE(N,'W') | N < 1 THEN RETURN 0
   DO I = 1 TO N; PARSE PULL DM.I; END
   DO I = 1 TO N
      IF POS(LEFT(DM.I,1), 'PA') = 0 THEN ITERATE
      C = MBKPEND('READ', FUNC, DM.I)
      IF C < 1 THEN ITERATE
      PULL .
      PARSE PULL D
      DO C - 1; PULL .; END
      IF LEFT(D, 9) = DID THEN RETURN 1
   END
   RETURN 0

/*====================================================================*/
/* WRITE-OFF APPROVAL                                                 */
/*====================================================================*/
APPROVE_LIST:
   IF POS('A', MBKAUTH('LEVELS', FUNC)) = 0 THEN DO
      CALL AUDIT 'DENIED', '', 'WRITE-OFF APPROVAL - NO LEVEL A'
      CALL MSG 'NOT AUTHORISED', 'YOU ARE NOT A WRITE-OFF APPROVER.'
      RETURN
   END
   CALL DB2_CONNECT
   DO FOREVER
      "TBCREATE GLSAPPR NOWRITE REPLACE",
         "NAMES(ASEL AMEM AREF AUSER ADATE AID AJREF AAMT ANOTE)"
      N = MBKPEND('LIST', FUNC, 'P*')
      IF \DATATYPE(N,'W') | N < 0 THEN RETURN
      DO I = 1 TO N; PARSE PULL M.I; END
      DO I = 1 TO N
         AMEM = M.I
         IF READ_ITEM(AMEM) <> 0 THEN ITERATE
         AREF = IREF; AUSER = IREQ; ADATE = IDATE
         PARSE VAR ICARD 1 AID 10 . 11 AJREF 27 . 43 ANOTE 103 .
         AAMT = STRIP(SUBSTR(IHDR, 58, 23))
         AAMT = WORD(AAMT, 3)
         ASEL = ''
         "TBADD GLSAPPR"
      END
      "TBTOP GLSAPPR"
      ACOUNT = N
      "TBDISPLAY GLSAPPR PANEL(MBKGLS2)"
      IF RC >= 8 THEN DO
         "TBEND GLSAPPR"
         RETURN
      END
      DO WHILE ZTDSELS > 0
         SEL = TRANSLATE(ASEL)
         IF SEL = 'A' THEN CALL APPROVE_ITEM AMEM
         IF SEL = 'R' THEN CALL REJECT_ITEM AMEM
         IF ZTDSELS > 1 THEN "TBDISPLAY GLSAPPR"
         ELSE ZTDSELS = 0
      END
      "TBEND GLSAPPR"
   END
   RETURN

APPROVE_ITEM:
   PARSE ARG IMEM
   IF READ_ITEM(IMEM) <> 0 THEN RETURN
   FE = MBKAUTH('FOUREYES', FUNC, IREQ)
   IF FE <> 0 THEN DO
      IF FE = 4 THEN T = 'YOU KEYED' IREF '- A SECOND USER MUST',
         'APPROVE THE WRITE-OFF.'
      ELSE T = 'YOU ARE NOT A WRITE-OFF APPROVER.'
      CALL AUDIT 'DENIED', IREF, 'APPROVE - FOUREYES RC' FE
      CALL MSG 'CANNOT APPROVE', T
      RETURN
   END
   /* RE-CHECK THE ITEM NOW - IT MAY HAVE BEEN CLEARED SINCE */
   SID = STRIP(LEFT(ICARD, 9), 'L', '0')
   IF DB2UP THEN DO
      CALL LOOKUP_ITEM SID
      IF RESULT = 0 THEN DO
         IF GISTAT <> 'O' THEN DO
            CALL MSG 'NOT OPEN', 'ITEM' SID 'IS NO LONGER OPEN -',
               'REJECT IT.'
            RETURN
         END
         IF GIAMT > WOMAX THEN DO
            CALL MSG 'OVER LIMIT', 'ITEM' SID 'IS' GIAMT '- OVER THE',
               'WRITE-OFF LIMIT. REJECT IT.'
            RETURN
         END
      END
   END
   IF SUBSTR(ICARD,27,8) <> LEFT(IREQ,8) |,
      SUBSTR(ICARD,35,8) <> '' THEN DO
      CALL AUDIT 'ERROR', IREF, 'MEMBER' IMEM 'ALTERED'
      CALL MSG 'ITEM INVALID', IREF 'WAS ALTERED OUTSIDE THE DIALOG.'
      RETURN
   END
   ICARD = OVERLAY(LEFT(USER,8), ICARD, 35)
   IHDR  = OVERLAY(LEFT(USER,8), IHDR, 49)
   QUEUE ICARD
   IF MBKPEND('WRITE', FUNC, 'A'SUBSTR(IMEM,2), IHDR) <> 0 THEN RETURN
   CALL MBKPEND 'DELETE', FUNC, IMEM
   CALL AUDIT 'APPROVE', IREF, 'WRITE-OFF ID' SID 'BY' IREQ
   "TBDELETE GLSAPPR"
   CALL MSG IREF 'APPROVED', 'WRITE-OFF' IREF 'APPROVED FOR CUT-OFF.'
   RETURN

REJECT_ITEM:
   PARSE ARG IMEM
   IF READ_ITEM(IMEM) <> 0 THEN RETURN
   RJKEY = IREF; RJTEXT = ''
   "ADDPOP ROW(6) COLUMN(10)"
   "DISPLAY PANEL(MBKREJ1)"
   PRC = RC
   "REMPOP"
   IF PRC >= 8 THEN RETURN
   IF MBKPEND('DELETE', FUNC, IMEM) <> 0 THEN RETURN
   CALL AUDIT 'REJECT', IREF, RJTEXT
   "TBDELETE GLSAPPR"
   IF IREQ <> USER THEN DO
      CALL OUTTRAP 'X.'
      ADDRESS TSO "SEND 'MBK: WRITE-OFF" IREF "REJECTED BY" USER"'",
         "USER("IREQ") LOGON"
      CALL OUTTRAP 'OFF'
   END
   RETURN

READ_ITEM:
   PARSE ARG RMEM
   C = MBKPEND('READ', FUNC, RMEM)
   IF \DATATYPE(C,'W') | C < 1 THEN DO
      CALL MSG 'NOT FOUND', 'MEMBER' RMEM 'WAS PROCESSED BY ANOTHER',
         'USER.'
      RETURN 8
   END
   PARSE PULL IHDR
   PARSE PULL ICARD
   DO C - 1; PULL .; END
   PARSE VAR IHDR 11 IREF 23 . 24 IREQ 32 . 33 IDATE 41 .
   IREF = STRIP(IREF); IREQ = STRIP(IREQ)
   RETURN 0

/*====================================================================*/
/* CUT-OFF RELEASE (SAME RULES AS MBKCGREF)                           */
/*====================================================================*/
RELEASE:
   IF MBKAUTH('CHECK', FUNC, 'R') <> 0 THEN DO
      CALL AUDIT 'DENIED', '', 'RELEASE - NO LEVEL R'
      CALL MSG 'NOT AUTHORISED', 'RELEASE NEEDS LEVEL R.'
      RETURN
   END
   NOW = SPACE(TRANSLATE(LEFT(TIME('N'),5),' ',':'),0)
   IF NOW >= '2130' | NOW < '0530' THEN DO
      CALL MSG 'AFTER CUT-OFF', 'NO RELEASE BETWEEN 21:30 AND 05:30.'
      RETURN
   END
   N = MBKPEND('LIST', FUNC, 'A*')
   IF \DATATYPE(N,'W') | N < 0 THEN RETURN
   IF N = 0 THEN DO
      CALL MSG 'NOTHING TO RELEASE', 'NO INSTRUCTIONS ARE WAITING.'
      RETURN
   END
   DO I = 1 TO N; PARSE PULL RM.I; END
   NEWC.0 = 0; RLCLR = 0; RLWO = 0
   DO I = 1 TO N
      IF READ_ITEM(RM.I) <> 0 THEN ITERATE
      IF SUBSTR(ICARD,10,1) = 'W' & SUBSTR(ICARD,35,8) = '' THEN ITERATE
      K = NEWC.0 + 1
      NEWC.K = ICARD; NEWM.K = RM.I; NEWC.0 = K
      IF SUBSTR(ICARD,10,1) = 'W' THEN RLWO = RLWO + 1
      ELSE RLCLR = RLCLR + 1
   END
   RLCOUNT = NEWC.0
   RLLAST = LAST_RELEASE()
   RLMERGE = 'N'
   IF RLLAST = MBKBDATE THEN RLMERGE = 'Y'
   RLCONF = ''
   "DISPLAY PANEL(MBKGLS3)"
   IF RC >= 8 | RLCONF <> 'Y' THEN RETURN

   ALL.0 = 0
   IF RLMERGE = 'Y' THEN DO
      CALL OUTTRAP 'X.'
      ADDRESS TSO "ALLOC F(GLSOLD) DA('"OUTDSN"(0)') OLD REUSE"
      ARC = RC
      CALL OUTTRAP 'OFF'
      IF ARC <> 0 THEN DO
         CALL MSG 'IN USE', OUTDSN'(0) IS IN USE - TRY AGAIN.'
         RETURN
      END
      ADDRESS TSO "EXECIO * DISKR GLSOLD (STEM ALL. FINIS"
      ADDRESS TSO "FREE F(GLSOLD)"
   END
   BASE = ALL.0
   DO I = 1 TO NEWC.0
      K = ALL.0 + 1; ALL.K = NEWC.I; ALL.0 = K
   END
   ADDRESS TSO "ALLOC F(GLSNEW) DA('"OUTDSN"(+1)') NEW CATALOG",
      "UNIT(SYSDA) SPACE(1 1) TRACKS RELEASE",
      "RECFM(F B) LRECL(120) BLKSIZE(0) REUSE"
   IF RC <> 0 THEN DO
      CALL MSG 'ALLOCATION FAILED', 'CANNOT CREATE' OUTDSN'(+1)'
      RETURN
   END
   ADDRESS TSO "EXECIO" ALL.0 "DISKW GLSNEW (STEM ALL. FINIS"
   WRC = RC
   X = LISTDSI('GLSNEW' 'FILE')
   GEN = SYSDSNAME
   ADDRESS TSO "FREE F(GLSNEW)"
   IF WRC <> 0 THEN DO
      CALL AUDIT 'ERROR', '', 'RELEASE WRITE' GEN 'RC='WRC
      CALL MSG 'WRITE FAILED', 'WRITE TO' GEN 'FAILED RC='WRC
      RETURN
   END
   DO I = 1 TO NEWC.0
      CALL MBKPEND 'DELETE', FUNC, NEWM.I
   END
   H = LEFT('*PEND',6)LEFT(FUNC,4)LEFT('RELCTL',13)LEFT(USER,9),
      || LEFT(DATE('S'),9)LEFT(SPACE(TRANSLATE(TIME('N'),' ',':'),0),7),
      || LEFT('',9)LEFT(MBKBDATE RIGHT(GEN,8), 23)
   CALL MBKPEND 'WRITE', FUNC, 'RELCTL', H
   CALL AUDIT 'RELEASE', RIGHT(GEN,8), RLCLR 'CLEARING(S)' RLWO,
      'WRITE-OFF(S) (+'BASE 'ALREADY RELEASED TODAY)'
   CALL MSG 'RELEASED', NEWC.0 'INSTRUCTION(S) WRITTEN TO' GEN'.'
   RETURN

LAST_RELEASE:
   C = MBKPEND('READ', FUNC, 'RELCTL')
   IF C < 0 THEN RETURN ''
   PARSE PULL H
   DO C; PULL .; END
   RETURN STRIP(SUBSTR(H, 58, 8))

/*====================================================================*/
/* UTILITIES                                                          */
/*====================================================================*/
AUDIT:
   PARSE ARG AACT, AKEY, ATXT
   CALL MBKAUDIT 'LOG', FUNC, AACT, AKEY, ATXT
   IF RESULT <> 0 THEN,
      CALL MSG 'AUDIT FAILURE', 'THE AUDIT LOG COULD NOT BE WRITTEN',
         '- STOP AND CALL CORE SYSTEMS SUPPORT.'
   RETURN

MSG: PROCEDURE
   PARSE ARG SHORT, LONG
   ZEDSMSG = SHORT
   ZEDLMSG = LONG
   ADDRESS ISPEXEC "SETMSG MSG(ISRZ001)"
   RETURN
