*********************************************************************
* CSD GROUP : MBKCOR3                                               *
* TITLE     : CORE BANKING ONLINE RESOURCES - 2012 CUSTOMER SELF    *
*             SERVICE (CHEQUE STOPS, OVERDRAFTS, STATEMENTS,        *
*             PREFERENCES) - REGION CICSPRD1 (AOR)                  *
* INPUT TO  : DFHCSDUP (JOB MBKCSDUP - SYSTEMS PROGRAMMING)         *
*-------------------------------------------------------------------*
* ADD MBKCOR3 TO LIST MBKLIST AFTER MBKCOR2:                        *
*   ADD GROUP(MBKCOR3) LIST(MBKLIST) AFTER(MBKCOR2)                 *
* SERVICE PROGRAMS ARE LINKED FROM CHROUTER (SERVICE TABLE) AND     *
* RUN UNDER THE MIRROR CHMI, SO THEY NEED NO TRANSACTION OF THEIR   *
* OWN. ACCTMST, ACCTCIF AND CIFMAST ARE IN MBKCORE; PRDPARM IS IN   *
* MBKCOR2. PSMEMO1 (LINKED FOR FEES) IS IN MBKCORE.                 *
*-------------------------------------------------------------------*
* RACF: FILE PROFILES FOR CHQSTOP AND STMTADH ARE IN RACF CLASS     *
* FCICSFCT (SR 12/0215). THE CPAU AUDIT DATASET HOLDS CUSTOMER      *
* CONTACT DETAILS - UACC(NONE), READ FOR GROUP MBKDPO ONLY.         *
*-------------------------------------------------------------------*
* BATCH INTERACTION                                                 *
*   CHQSTOP  READ BY CQCLR010 (CQCLR01, DISP=OLD) - CLOSED BY       *
*            MBKONLDN BEFORE THE INWARD CLEARING RUN                *
*   STMTADH  UNLOADED BY STMT01 ST012, RESET BY ST016 - CLOSED BY   *
*            MBKONLDN BEFORE STMT01                                 *
*   ODAU     SWEPT DAILY BY ODAUSWP1 TO CREDIT RISK MI              *
*   CPAU     SWEPT DAILY BY CPAUSWP1 TO THE DPO CONSENT STORE       *
*-------------------------------------------------------------------*
* HISTORY                                                           *
* 2012-02-13 JNB  ORIGINAL - CHQSTOP (CQSTP01), FILE CHQSTOP        *
* 2012-04-23 PLW  ODLIMIT (ODLIM01), TDQ ODAU                       *
* 2012-06-11 JNB  STMTREQ (STREQ01), FILE STMTADH                   *
* 2012-09-03 AOS  CUSTPREF (CFPRF01), TDQ CPAU                      *
* 2013-06-24 PDQ  SWITCHRQ (CSSVC01) - FILE SWITCHES IS IN MBKCOR2  *
* 2013-07-08 PDQ  CS01 BRANCH SWITCH SCREEN (CSSCRN1, MAPSET CSMAPS)*
* 2017-03-06 PDQ  SAVSWP (SAVINGS SWEEP), ALRTPRF (ALERT PREFS)     *
*********************************************************************
DELETE GROUP(MBKCOR3)
*
*----------------------------------------------- SERVICE PROGRAMS ---*
DEFINE PROGRAM(CQSTP01) GROUP(MBKCOR3) LANGUAGE(LE370)
       DESCRIPTION(CHEQUE STOPS - SERVICE CHQSTOP)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(ODLIM01) GROUP(MBKCOR3) LANGUAGE(LE370)
       DESCRIPTION(ARRANGED OVERDRAFT LIMIT - SERVICE ODLIMIT)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(STREQ01) GROUP(MBKCOR3) LANGUAGE(LE370)
       DESCRIPTION(AD-HOC / DUPLICATE STATEMENT - SERVICE STMTREQ)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(CFPRF01) GROUP(MBKCOR3) LANGUAGE(LE370)
       DESCRIPTION(CUSTOMER PREFERENCES - SERVICE CUSTPREF)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(CSSVC01) GROUP(MBKCOR3) LANGUAGE(LE370)
       DESCRIPTION(CASS SWITCH-IN REQUEST - SERVICE SWITCHRQ)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(CSSCRN1) GROUP(MBKCOR3) LANGUAGE(LE370)
       DESCRIPTION(BRANCH - CURRENT ACCOUNT SWITCH (CS01))
DEFINE MAPSET(CSMAPS) GROUP(MBKCOR3)
       DESCRIPTION(CURRENT ACCOUNT SWITCH MAPSET)
DEFINE TRANSACTION(CS01) GROUP(MBKCOR3) PROGRAM(CSSCRN1)
       DESCRIPTION(BRANCH - CURRENT ACCOUNT SWITCH)
       PROFILE(DFHCICST) RESSEC(YES)
*
*--------------------------------------------------------- FILES ---*
* CHQSTOP - REMOVED STOPS ARE KEPT (STATUS R), SO DELETE(NO).       *
DEFINE FILE(TAXCERT) GROUP(MBKCOR3)
       DSNAME(MBK.PRD.TAX.SELFCERT)
       DESCRIPTION(FATCA / CRS TAX SELF-CERTIFICATIONS (TAXCR010))
       ADD(YES) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(FIRSTREF) STRINGS(5)
       LSRPOOLID(1)
DEFINE FILE(SAVSWP) GROUP(MBKCOR3)
       DSNAME(MBK.PRD.SAV.SWEEP)
       DESCRIPTION(SAVINGS SWEEP INSTRUCTIONS (SVSWP010))
       ADD(YES) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(FIRSTREF) STRINGS(5)
       LSRPOOLID(1)
DEFINE FILE(ALRTPRF) GROUP(MBKCOR3)
       DSNAME(MBK.PRD.DDA.ALERTPRF)
       DESCRIPTION(CUSTOMER ALERT PREFERENCES (DDALR010))
       ADD(YES) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(FIRSTREF) STRINGS(5)
       LSRPOOLID(1)
DEFINE FILE(CHQSTOP) GROUP(MBKCOR3)
       DSNAME(MBK.PRD.CHQ.STOPS)
       DESCRIPTION(CHEQUE STOPS - CQS- IN CHQRECS)
       ADD(YES) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(STARTUP) STRINGS(10)
       LSRPOOLID(1)
* STMTADH - KSDS RECORDSIZE(100 100) KEYS(31 0), STREQREC LAYOUT.   *
* DEFINED REUSE SO STMT01 ST016 CAN EMPTY IT.                       *
DEFINE FILE(STMTADH) GROUP(MBKCOR3)
       DSNAME(MBK.PRD.STMT.ADHOC)
       DESCRIPTION(AD-HOC AND DUPLICATE STATEMENT REQUESTS)
       ADD(YES) BROWSE(YES) DELETE(YES) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(FIRSTREF) STRINGS(5)
       LSRPOOLID(1)
*
*---------------------------------------------- TRANSIENT DATA ----*
DEFINE TDQUEUE(ODAU) GROUP(MBKCOR3)
       DESCRIPTION(OVERDRAFT LIMIT DECISION AUDIT (ODLIM01))
       TYPE(EXTRA) DDNAME(ODAUOUT)
       DSNAME(MBK.PRD.CICS.ODAU) RECORDFORMAT(FIXED)
       BLOCKFORMAT(BLOCKED) RECORDSIZE(250) BLOCKSIZE(27750)
       TYPEFILE(OUTPUT) DISPOSITION(MOD)
DEFINE TDQUEUE(CPAU) GROUP(MBKCOR3)
       DESCRIPTION(CUSTOMER PREFERENCE / CONSENT AUDIT (CFPRF01))
       TYPE(EXTRA) DDNAME(CPAUOUT)
       DSNAME(MBK.PRD.CICS.CPAU) RECORDFORMAT(FIXED)
       BLOCKFORMAT(BLOCKED) RECORDSIZE(400) BLOCKSIZE(27600)
       TYPEFILE(OUTPUT) DISPOSITION(MOD)
