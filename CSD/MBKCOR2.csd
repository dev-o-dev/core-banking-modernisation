*********************************************************************
* CSD GROUP : MBKCOR2                                               *
* TITLE     : CORE BANKING ONLINE RESOURCES - 2010/2011 SERVICES    *
*             REGION CICSPRD1 (AOR)                                 *
* INPUT TO  : DFHCSDUP (JOB MBKCSDUP - SYSTEMS PROGRAMMING)         *
*-------------------------------------------------------------------*
* ADD MBKCOR2 TO LIST MBKLIST AFTER MBKCORE:                        *
*   ADD GROUP(MBKCOR2) LIST(MBKLIST) AFTER(MBKCORE)                 *
* SERVICE PROGRAMS ARE LINKED FROM CHROUTER (SERVICE TABLE) AND     *
* RUN UNDER THE MIRROR CHMI, SO THEY NEED NO TRANSACTION OF THEIR   *
* OWN. BRANCH SCREENS HAVE ONE TRANSACTION EACH.                    *
*-------------------------------------------------------------------*
* RACF: ALL NEW TRANSACTIONS ARE RESSEC(YES). FILE PROFILES FOR     *
* LOANMST, FXRATES AND CIFCTL ARE IN RACF CLASS FCICSFCT (SR 10/774)*
*-------------------------------------------------------------------*
* HISTORY                                                           *
* 2010-03-08 AOS  ORIGINAL - SO, DD MANDATE, ACCOUNT OPEN/CLOSE,    *
*                 HOLDS, TXN HISTORY, CIF MAINTENANCE, REVERSAL,    *
*                 BRANCH SCREENS CF02 / DD03 / SO01                 *
* 2010-08-02 JNB  CARDAUTH (CRDAUT01) AND TCLASS MBKCRD             *
* 2010-10-04 JNB  LOANENQ (LNSVC01), LN01 SCREEN                    *
* 2011-03-14 AOS  DM01 MANDATE SCREEN, DD04 HOLDS SCREEN            *
* 2011-05-16 JNB  FXQUOTE (FXSVC01), FX01 RATE BOARD                *
* 2011-07-04 AOS  SAVNTC NOTICE SAVINGS FILE                        *
* 2013-06-17 PDQ  SWITCHES - CASS SWITCH CONTROL                    *
*********************************************************************
DELETE GROUP(MBKCOR2)
*
*----------------------------------------------- SERVICE PROGRAMS ---*
DEFINE PROGRAM(SOMNT01) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(STANDING ORDER MAINTENANCE - SERVICE SOMAINT)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(DMSVC01) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(DIRECT DEBIT MANDATES - SERVICE DDMANDT)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(DDOPN01) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(ACCOUNT OPENING - SERVICE ACCTOPEN)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(DDCLS01) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(ACCOUNT CLOSURE QUOTE / REQUEST - SERVICE ACCTCLOS)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(DDHLD01) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(FUNDS HOLDS - SERVICE ACCTHOLD)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(DDTXN01) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(TRANSACTION HISTORY - SERVICE TXNHIST)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(CFMNT01) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(CIF MAINTENANCE - SERVICE CIFMAINT)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(PSREV01) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(SAME-DAY POSTING REVERSAL - SERVICE POSTREV)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(CRDAUT01) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(DEBIT CARD AUTHORISATION - SERVICE CARDAUTH)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(LNSVC01) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(PERSONAL LOAN ENQUIRY - SERVICE LOANENQ)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(FXSVC01) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(FX QUOTE / VALIDATE - SERVICE FXQUOTE)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
*
*------------------------------------------ CALLED SUBPROGRAMS ------*
* STATICALLY LINKED INTO THEIR CALLERS. DEFINED SO THAT THE TELLER  *
* SYSTEM (PL/I) CAN CALL THEM DYNAMICALLY, AS FOR DTEUTIL.          *
DEFINE PROGRAM(DDMODCK) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(VOCALINK MODULUS CHECK)
DEFINE PROGRAM(DDIBAN1) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(IBAN GENERATE / VALIDATE / SPLIT)
*
*------------------------------------------------ BRANCH SCREENS ---*
DEFINE PROGRAM(CFSCRN2) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(BRANCH - CUSTOMER ACCOUNT LIST (CF02))
DEFINE PROGRAM(DDSCRN3) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(BRANCH - TRANSACTION HISTORY (DD03))
DEFINE PROGRAM(DDSCRN4) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(BRANCH - FUNDS HOLDS (DD04))
DEFINE PROGRAM(SOSCRN1) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(BRANCH - STANDING ORDERS (SO01))
DEFINE PROGRAM(DMSCRN1) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(BRANCH - DIRECT DEBIT MANDATES (DM01))
DEFINE PROGRAM(LNSCRN1) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(BRANCH - PERSONAL LOAN ENQUIRY (LN01))
DEFINE PROGRAM(FXSCRN1) GROUP(MBKCOR2) LANGUAGE(LE370)
       DESCRIPTION(BRANCH - FX RATE BOARD (FX01))
*
*------------------------------------------------------- MAPSETS ---*
DEFINE MAPSET(CFMAP2) GROUP(MBKCOR2)
       DESCRIPTION(CUSTOMER ACCOUNT LIST MAPSET)
DEFINE MAPSET(DDMAP3) GROUP(MBKCOR2)
       DESCRIPTION(TRANSACTION HISTORY MAPSET)
DEFINE MAPSET(DDMAP4) GROUP(MBKCOR2)
       DESCRIPTION(FUNDS HOLDS MAPSET)
DEFINE MAPSET(SOMAPS) GROUP(MBKCOR2)
       DESCRIPTION(STANDING ORDER LIST / DETAIL MAPSET)
DEFINE MAPSET(DMMAPS) GROUP(MBKCOR2)
       DESCRIPTION(DIRECT DEBIT MANDATE MAPSET)
DEFINE MAPSET(LNMAPS) GROUP(MBKCOR2)
       DESCRIPTION(PERSONAL LOAN ENQUIRY MAPSET)
DEFINE MAPSET(FXMAPS) GROUP(MBKCOR2)
       DESCRIPTION(FX RATE BOARD MAPSET)
*
*-------------------------------------------------- TRANSACTIONS ---*
DEFINE TRANSACTION(CF02) GROUP(MBKCOR2) PROGRAM(CFSCRN2)
       DESCRIPTION(BRANCH - CUSTOMER ACCOUNT LIST)
       PROFILE(DFHCICST) RESSEC(YES)
DEFINE TRANSACTION(DD03) GROUP(MBKCOR2) PROGRAM(DDSCRN3)
       DESCRIPTION(BRANCH - TRANSACTION HISTORY)
       PROFILE(DFHCICST) RESSEC(YES)
DEFINE TRANSACTION(DD04) GROUP(MBKCOR2) PROGRAM(DDSCRN4)
       DESCRIPTION(BRANCH - FUNDS HOLDS)
       PROFILE(DFHCICST) RESSEC(YES)
DEFINE TRANSACTION(SO01) GROUP(MBKCOR2) PROGRAM(SOSCRN1)
       DESCRIPTION(BRANCH - STANDING ORDERS)
       PROFILE(DFHCICST) RESSEC(YES)
DEFINE TRANSACTION(DM01) GROUP(MBKCOR2) PROGRAM(DMSCRN1)
       DESCRIPTION(BRANCH - DIRECT DEBIT MANDATES)
       PROFILE(DFHCICST) RESSEC(YES)
DEFINE TRANSACTION(LN01) GROUP(MBKCOR2) PROGRAM(LNSCRN1)
       DESCRIPTION(BRANCH - PERSONAL LOAN ENQUIRY)
       PROFILE(DFHCICST) RESSEC(YES)
DEFINE TRANSACTION(FX01) GROUP(MBKCOR2) PROGRAM(FXSCRN1)
       DESCRIPTION(BRANCH - FX RATE BOARD)
       PROFILE(DFHCICST) RESSEC(YES)
*
* CARD AUTHORISATIONS ARRIVE ON THEIR OWN MIRROR SO THAT A FLOOD OF  *
* CARD TRAFFIC CANNOT STARVE IBANK (TCLASS MBKCRD). THE CARD        *
* GATEWAY CONNECTION (IPIC MBKCARD) SPECIFIES MIRROR CHMC.          *
DEFINE TRANSACTION(CHMC) GROUP(MBKCOR2) PROGRAM(DFHMIR)
       DESCRIPTION(CHANNEL MIRROR - CARD AUTHORISATION GATEWAY)
       TCLASS(MBKCRD) PROFILE(DFHCICSA) DTIMOUT(5)
       SPURGE(YES) TPURGE(YES) RESSEC(YES) PRIORITY(220)
DEFINE TRANCLASS(MBKCRD) GROUP(MBKCOR2) MAXACTIVE(60) PURGETHRESH(120)
*
*--------------------------------------------------------- FILES ---*
DEFINE FILE(SOMAST) GROUP(MBKCOR2)
       DSNAME(MBK.PRD.SO.MASTER)
       DESCRIPTION(STANDING ORDER MASTER)
       ADD(YES) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(STARTUP) STRINGS(10)
       LSRPOOLID(1)
DEFINE FILE(DDMAND) GROUP(MBKCOR2)
       DSNAME(MBK.PRD.DDM.MANDATE)
       DESCRIPTION(DIRECT DEBIT MANDATES)
       ADD(NO) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(STARTUP) STRINGS(10)
       LSRPOOLID(1)
DEFINE FILE(DDHOLD) GROUP(MBKCOR2)
       DSNAME(MBK.PRD.DDA.HOLDS)
       DESCRIPTION(ACCOUNT FUNDS HOLDS)
       ADD(YES) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(STARTUP) STRINGS(40)
       LSRPOOLID(1)
DEFINE FILE(CHGPEND) GROUP(MBKCOR2)
       DSNAME(MBK.PRD.CHG.PENDING)
       DESCRIPTION(NOTIFIED CHARGES AWAITING APPLICATION)
       ADD(NO) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(NO)
       OPENTIME(FIRSTREF) STRINGS(5) LSRPOOLID(1)
DEFINE FILE(PRDPARM) GROUP(MBKCOR2)
       DSNAME(MBK.PRD.PRD.PARMS)
       DESCRIPTION(PRODUCT PARAMETERS - READ ONLY ONLINE)
       ADD(NO) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(NO)
       OPENTIME(STARTUP) STRINGS(10) LSRPOOLID(1)
       READINTEG(UNCOMMITTED)
DEFINE FILE(ACCTNOC) GROUP(MBKCOR2)
       DSNAME(MBK.PRD.DDA.ACCTNO.CONTROL)
       DESCRIPTION(ACCOUNT NUMBER ALLOCATION CONTROL - ONE PER RANGE)
       ADD(NO) BROWSE(NO) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(STARTUP) STRINGS(5)
       LSRPOOLID(2)
DEFINE FILE(CIFCTL) GROUP(MBKCOR2)
       DSNAME(MBK.PRD.CIF.CONTROL)
       DESCRIPTION(CIF NUMBER ALLOCATION CONTROL)
       ADD(NO) BROWSE(NO) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(STARTUP) STRINGS(5)
       LSRPOOLID(2)
DEFINE FILE(LOANMST) GROUP(MBKCOR2)
       DSNAME(MBK.PRD.LOAN.MASTER)
       DESCRIPTION(PERSONAL LOAN MASTER - UPDATE FOR QUOTES ONLY)
       ADD(NO) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(FIRSTREF) STRINGS(10)
       LSRPOOLID(1)
DEFINE FILE(LOANCIF) GROUP(MBKCOR2)
       DSNAME(MBK.PRD.LOAN.MASTER.CIFPATH)
       DESCRIPTION(PERSONAL LOAN MASTER - PATH BY CIF NUMBER)
       ADD(NO) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(NO)
       OPENTIME(FIRSTREF) STRINGS(5) LSRPOOLID(1)
DEFINE FILE(SAVNTC) GROUP(MBKCOR2)
       DSNAME(MBK.PRD.SAV.NOTICES)
       DESCRIPTION(NOTICE SAVINGS WITHDRAWAL NOTICES (INNTC010))
       ADD(YES) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(STARTUP) STRINGS(5)
       LSRPOOLID(1)
DEFINE FILE(SWITCHES) GROUP(MBKCOR2)
       DSNAME(MBK.PRD.CASS.SWITCHES)
       DESCRIPTION(CASS CURRENT ACCOUNT SWITCHES (CSSIN010/CSSOU010))
       ADD(YES) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(FIRSTREF) STRINGS(5)
       LSRPOOLID(1)
DEFINE FILE(FXRATES) GROUP(MBKCOR2)
       DSNAME(MBK.PRD.FX.RATES)
       DESCRIPTION(FX RATE TABLE - UPDATED BY BATCH FXRAT010)
       ADD(NO) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(NO)
       OPENTIME(STARTUP) STRINGS(10) LSRPOOLID(NONE)
       DATABUFFERS(20) INDEXBUFFERS(5)
*
* FXRATES IS NOT IN AN LSR POOL: FXRAT010 UPDATES THE DATASET IN    *
* BATCH WHILE CICS HAS IT OPEN (SHAREOPTIONS(2 3)). NSR BUFFERS ARE  *
* REFRESHED ON EACH READ, SO CICS SEES THE NEW RATE AT ONCE.        *
*
*---------------------------------------------- TRANSIENT DATA ----*
DEFINE TDQUEUE(CFAU) GROUP(MBKCOR2)
       DESCRIPTION(CIF MAINTENANCE AUDIT TRAIL (CFMNT01))
       TYPE(EXTRA) DDNAME(CFAUOUT)
       DSNAME(MBK.PRD.CICS.CFAU) RECORDFORMAT(FIXED)
       BLOCKFORMAT(BLOCKED) RECORDSIZE(300) BLOCKSIZE(27900)
       TYPEFILE(OUTPUT) DISPOSITION(MOD)
*
*------------------------------------------------------ DB2ENTRY ---*
* DDTXN01 RUNS UNDER CHMI (CHANNELS) AND DD03 (BRANCH VIA LINK).    *
DEFINE DB2ENTRY(MBKTXH) GROUP(MBKCOR2)
       DESCRIPTION(TRANSACTION HISTORY ENQUIRY - PLAN MBKCICS2)
       TRANSID(DD03) PLAN(MBKCICS2) AUTHTYPE(GROUP)
       PROTECTNUM(5) THREADLIMIT(15) THREADWAIT(POOL)
DEFINE DB2TRAN(MBKDD03) GROUP(MBKCOR2)
       ENTRY(MBKTXH) TRANSID(DD03)
