*********************************************************************
* CSD GROUP : MBKCORE                                               *
* TITLE     : CORE BANKING ONLINE RESOURCES - REGION CICSPRD1 (AOR) *
* INPUT TO  : DFHCSDUP (JOB MBKCSDUP - SYSTEMS PROGRAMMING)         *
*-------------------------------------------------------------------*
* GROUP MBKCORE IS IN LIST MBKLIST (GRPLIST=(DFHLIST,MBKLIST)).     *
* RELATED GROUPS NOT IN THIS MEMBER:                                *
*   MBKCTG   - CTG/IPIC CONNECTION FROM THE IBANK GATEWAY TIER      *
*   MBKMQ    - MQCONN FOR QUEUE MANAGER MQP1, CKTI INITIATION QUEUE *
*   MBKDB2   - DB2CONN (DB2P) AND DB2ENTRY DEFINITIONS              *
*   MBKCOR2  - 2010/2011 SERVICES, SCREENS AND FILES (MEMBER        *
*              MBKCOR2)                                             *
*-------------------------------------------------------------------*
* 2010-03-08 AOS  ACCTMST ADD(YES) - ACCOUNT OPENING (DDOPN01)      *
*                 CIFMAST ADD(YES) - NEW CUSTOMERS (CFMNT01)        *
*                 PSTXREF UPDATE(YES) - REVERSAL MARKER (PSREV01)   *
*********************************************************************
DELETE GROUP(MBKCORE)
*
*------------------------------------------------------ PROGRAMS ---*
DEFINE PROGRAM(CHROUTER) GROUP(MBKCORE) LANGUAGE(LE370)
       DESCRIPTION(CHANNEL SERVICE ROUTER - DPL ENTRY POINT)
       EXECKEY(USER) CONCURRENCY(QUASIRENT) DATALOCATION(ANY)
DEFINE PROGRAM(CFINQ01) GROUP(MBKCORE) LANGUAGE(LE370)
       DESCRIPTION(CIF CUSTOMER ENQUIRY - SERVICE CIFINQ)
DEFINE PROGRAM(DDINQ01) GROUP(MBKCORE) LANGUAGE(LE370)
       DESCRIPTION(ACCOUNT BALANCE ENQUIRY - SERVICE ACCTINQ)
DEFINE PROGRAM(DDLST01) GROUP(MBKCORE) LANGUAGE(LE370)
       DESCRIPTION(ACCOUNTS FOR CUSTOMER - SERVICE ACCTLIST)
DEFINE PROGRAM(PSMEMO1) GROUP(MBKCORE) LANGUAGE(LE370)
       DESCRIPTION(MEMO POSTING - SERVICE MEMOPOST)
DEFINE PROGRAM(PYINIT1) GROUP(MBKCORE) LANGUAGE(LE370)
       DESCRIPTION(PAYMENT INITIATION - SERVICE PAYINIT)
DEFINE PROGRAM(PYFPRSP) GROUP(MBKCORE) LANGUAGE(LE370)
       DESCRIPTION(FPS GATEWAY RESPONSE PROCESSOR)
DEFINE PROGRAM(MGSTUB1) GROUP(MBKCORE) LANGUAGE(LE370)
       DESCRIPTION(MORTGAGE ENQUIRY STUB - SERVICE MORTINQ)
DEFINE PROGRAM(CFSCRN1) GROUP(MBKCORE) LANGUAGE(LE370)
       DESCRIPTION(BRANCH CUSTOMER ENQUIRY SCREEN)
DEFINE PROGRAM(DTEUTIL) GROUP(MBKCORE) LANGUAGE(LE370)
       DESCRIPTION(DATE UTILITY - STATICALLY LINKED, DEFINED FOR
       DYNAMIC CALL FROM PL/I TELLER PROGRAMS)
*
*------------------------------------------------------- MAPSETS ---*
DEFINE MAPSET(CFMAPS) GROUP(MBKCORE)
       DESCRIPTION(CIF BRANCH ENQUIRY MAPSET)
*
*-------------------------------------------------- TRANSACTIONS ---*
* CHMI - MIRROR TRANSACTION USED BY THE CTG FOR CHANNEL CALLS.      *
* SEPARATE FROM CSMI SO THAT IT CAN HAVE ITS OWN TCLASS AND RACF    *
* PROFILE (ONLY THE IBANK GATEWAY USER ID MBKIBGW MAY RUN IT).      *
DEFINE TRANSACTION(CHMI) GROUP(MBKCORE) PROGRAM(DFHMIR)
       DESCRIPTION(CHANNEL MIRROR - CTG ECI REQUESTS)
       TCLASS(MBKCHN) PROFILE(DFHCICSA) DTIMOUT(30)
       SPURGE(YES) TPURGE(YES) RESSEC(YES)
DEFINE TRANSACTION(CF01) GROUP(MBKCORE) PROGRAM(CFSCRN1)
       DESCRIPTION(BRANCH CUSTOMER ENQUIRY)
       PROFILE(DFHCICST) RESSEC(YES)
DEFINE TRANSACTION(PYFR) GROUP(MBKCORE) PROGRAM(PYFPRSP)
       DESCRIPTION(FPS RESPONSE PROCESSOR - STARTED BY CKTI)
       TCLASS(MBKPAY) PRIORITY(200)
DEFINE TRANCLASS(MBKCHN) GROUP(MBKCORE) MAXACTIVE(40) PURGETHRESH(80)
DEFINE TRANCLASS(MBKPAY) GROUP(MBKCORE) MAXACTIVE(1)
*
*--------------------------------------------------------- FILES ---*
DEFINE FILE(CIFMAST) GROUP(MBKCORE)
       DSNAME(MBK.PRD.CIF.MASTER)
       DESCRIPTION(CIF CUSTOMER MASTER)
       ADD(YES) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(STARTUP) STRINGS(20)
       LSRPOOLID(1)
DEFINE FILE(ACCTMST) GROUP(MBKCORE)
       DSNAME(MBK.PRD.DDA.ACCTMAST)
       DESCRIPTION(DDA ACCOUNT MASTER - BASE CLUSTER)
       ADD(YES) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(STARTUP) STRINGS(40)
       LSRPOOLID(1)
DEFINE FILE(ACCTCIF) GROUP(MBKCORE)
       DSNAME(MBK.PRD.DDA.ACCTMAST.CIFPATH)
       DESCRIPTION(DDA ACCOUNT MASTER - PATH BY CIF NUMBER)
       ADD(NO) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(NO)
       OPENTIME(STARTUP) STRINGS(20) LSRPOOLID(1)
DEFINE FILE(MEMOLOG) GROUP(MBKCORE)
       DSNAME(MBK.PRD.PST.MEMOLOG)
       DESCRIPTION(MEMO POSTING LOG - ESDS)
       ADD(YES) BROWSE(NO) DELETE(NO) READ(NO) UPDATE(NO)
       RECOVERY(BACKOUTONLY) OPENTIME(STARTUP) STRINGS(20)
       LSRPOOLID(2)
DEFINE FILE(PSTXREF) GROUP(MBKCORE)
       DSNAME(MBK.PRD.PST.EXTREF)
       DESCRIPTION(POSTING EXTERNAL REFERENCE - DUPLICATE CHECK)
       ADD(YES) BROWSE(NO) DELETE(NO) READ(YES) UPDATE(YES)
       RECOVERY(BACKOUTONLY) OPENTIME(STARTUP) STRINGS(20)
       LSRPOOLID(2)
*
*---------------------------------------------- TRANSIENT DATA ----*
DEFINE TDQUEUE(CHLG) GROUP(MBKCORE)
       DESCRIPTION(CHANNEL ROUTER AUDIT LOG)
       TYPE(EXTRA) DDNAME(CHLGOUT)
       DSNAME(MBK.PRD.CICS.CHLG) RECORDFORMAT(FIXED)
       BLOCKFORMAT(BLOCKED) RECORDSIZE(160) BLOCKSIZE(27840)
       TYPEFILE(OUTPUT) DISPOSITION(MOD)
*
*------------------------------------------------------ DB2ENTRY ---*
DEFINE DB2ENTRY(MBKPAY) GROUP(MBKCORE)
       DESCRIPTION(PAYMENTS PROGRAMS - PLAN MBKCICS1)
       TRANSID(CHMI) PLAN(MBKCICS1) AUTHTYPE(GROUP)
       PROTECTNUM(10) THREADLIMIT(20) THREADWAIT(POOL)
DEFINE DB2TRAN(MBKPYFR) GROUP(MBKCORE)
       ENTRY(MBKPAY) TRANSID(PYFR)
