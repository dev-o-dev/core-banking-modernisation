*********************************************************************
* MEMBER   : MBKBIND                                                *
* TITLE    : DB2 BIND - PACKAGES AND PLANS FOR CORE BANKING         *
* INPUT TO : IKJEFT01 SYSTSIN (ENDEVOR PROCESSOR BIND STEP, OR      *
*            MANUALLY BY THE DBA AFTER AN EMERGENCY FIX)            *
*-------------------------------------------------------------------*
* COLLECTION MBKCORE. ONE PACKAGE PER DB2 PROGRAM.                  *
* CICS PROGRAMS SHARE PLAN MBKCICS1; BATCH PROGRAMS HAVE ONE PLAN   *
* EACH, NAMED AFTER THE PROGRAM.                                    *
* PLAN MBKCICS2 IS FOR DB2ENTRY MBKTXH (TRANSACTION DD03, CSD GROUP *
* MBKCOR2). DDTXN01 IS IN BOTH CICS PLANS: MBKCICS1 WHEN LINKED     *
* FROM CHROUTER UNDER CHMI (POOL THREAD), MBKCICS2 WHEN LINKED FROM *
* DDSCRN3 UNDER DD03 (ENTRY THREAD).                                *
*-------------------------------------------------------------------*
* ISOLATION(UR) ONLY FOR READ-ONLY EXTRACTS THAT TOLERATE           *
* UNCOMMITTED DATA (IBFD0201, INTAX010, ISASUB10, STSTM020,         *
* CHGTAR10).                                                        *
* RELEASE(DEALLOCATE) FOR THE LONG-RUNNING NIGHTLY BATCH THAT       *
* COMMITS EVERY N ROWS.                                             *
*-------------------------------------------------------------------*
* HISTORY                                                           *
* 2011-06-13 JNB  PACKAGES AND PLANS FOR THE 2009-2011 SUITES AND   *
*                 PLAN MBKCICS2. THEY HAD BEEN BOUND ONLY BY THE    *
*                 ENDEVOR PROCESSOR AND WERE MISSING FROM THIS      *
*                 MEMBER (DBA EMERGENCY REBIND WOULD HAVE MISSED    *
*                 THEM)                                             *
* 2014-08-11 PDQ  PSARC010 (TXNHIST ARCHIVE/PURGE, COMMITS EVERY    *
*                 COMMITFQ ROWS) AND CHGTAR10 (ANNUAL CHARGES       *
*                 SUMMARY, READ ONLY WITH UR)                       *
*********************************************************************
DSN SYSTEM(DB2P)
BIND PACKAGE(MBKCORE) MEMBER(PYINIT1)  OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(COMMIT) -
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(PYFPRSP)  OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(COMMIT) -
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(PSEOD010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(IBFD0201) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(UR) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(PYBAC010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(COMMIT) -
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(PYSWF010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(COMMIT) -
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
*
* ---- CICS - 2010/2011 CHANNEL SERVICES ----------------------------
BIND PACKAGE(MBKCORE) MEMBER(DDTXN01)  OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(COMMIT) -
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
*
* ---- BATCH - 2010/2011 SUITES -------------------------------------
BIND PACKAGE(MBKCORE) MEMBER(INCAP010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(CGCAL010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(CGAPL010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(COMMIT) -
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(CGREF010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(COMMIT) -
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(SOEXE010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(INTAX010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(UR) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(ISASUB10) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(UR) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(STSTM020) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(UR) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(GLEXT010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(GLREC010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(COMMIT) -
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(GLSUS010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(COMMIT) -
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(RGAML010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(LNBKG010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(COMMIT) -
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(LNREP010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(LNARR010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(LNSTM010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(COMMIT) -
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(FXRAT010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(COMMIT) -
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
*
* ---- BATCH - TXNHIST ARCHIVE, ANNUAL CHARGES SUMMARY -------------
BIND PACKAGE(MBKCORE) MEMBER(PSARC010) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(CS) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
BIND PACKAGE(MBKCORE) MEMBER(CHGTAR10) OWNER(MBKDBA) QUALIFIER(MBK) -
     ACTION(REPLACE) ISOLATION(UR) VALIDATE(BIND) RELEASE(DEALLOCATE)-
     CURRENTDATA(NO) EXPLAIN(YES) LIBRARY('MBK.PRD.DBRMLIB')
*
BIND PLAN(MBKCICS1) PKLIST(MBKCORE.PYINIT1, MBKCORE.PYFPRSP,     -
     MBKCORE.DDTXN01)                                              -
     OWNER(MBKDBA) ACTION(REPLACE) ACQUIRE(USE) RELEASE(COMMIT)
BIND PLAN(MBKCICS2) PKLIST(MBKCORE.DDTXN01) -
     OWNER(MBKDBA) ACTION(REPLACE) ACQUIRE(USE) RELEASE(COMMIT)
BIND PLAN(PSEOD010) PKLIST(MBKCORE.PSEOD010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(IBFD0201) PKLIST(MBKCORE.IBFD0201) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(PYBAC010) PKLIST(MBKCORE.PYBAC010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(PYSWF010) PKLIST(MBKCORE.PYSWF010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(INCAP010) PKLIST(MBKCORE.INCAP010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(CGCAL010) PKLIST(MBKCORE.CGCAL010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(CGAPL010) PKLIST(MBKCORE.CGAPL010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(CGREF010) PKLIST(MBKCORE.CGREF010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(SOEXE010) PKLIST(MBKCORE.SOEXE010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(INTAX010) PKLIST(MBKCORE.INTAX010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(ISASUB10) PKLIST(MBKCORE.ISASUB10) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(STSTM020) PKLIST(MBKCORE.STSTM020) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(GLEXT010) PKLIST(MBKCORE.GLEXT010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(GLREC010) PKLIST(MBKCORE.GLREC010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(GLSUS010) PKLIST(MBKCORE.GLSUS010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(RGAML010) PKLIST(MBKCORE.RGAML010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(LNBKG010) PKLIST(MBKCORE.LNBKG010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(LNREP010) PKLIST(MBKCORE.LNREP010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(LNARR010) PKLIST(MBKCORE.LNARR010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(LNSTM010) PKLIST(MBKCORE.LNSTM010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(FXRAT010) PKLIST(MBKCORE.FXRAT010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(PSARC010) PKLIST(MBKCORE.PSARC010) OWNER(MBKDBA) -
     ACTION(REPLACE)
BIND PLAN(CHGTAR10) PKLIST(MBKCORE.CHGTAR10) OWNER(MBKDBA) -
     ACTION(REPLACE)
END
