//MBKDEFVS JOB (MBK,DBA,VSAM),'DEFINE CORE VSAM',
//             CLASS=A,MSGCLASS=X,TYPRUN=HOLD
//*********************************************************************
//* JOB      : MBKDEFVS                                               *
//* TITLE    : DEFINE CORE VSAM FILES (CIF, ACCOUNT MASTER + AIX,     *
//*            MEMO LOG, EXTERNAL REFERENCE) AND THE 2010/2011        *
//*            SUITES (SO, DD MANDATES, HOLDS, CHARGES, PRODUCTS,     *
//*            NUMBER CONTROLS, RATES, CHEQUES, LOANS, FX, GDGS)      *
//*-------------------------------------------------------------------*
//* !!! DESTRUCTIVE - EACH MEMBER DELETES THE EXISTING CLUSTER !!!    *
//* FOR INITIAL BUILD OR A REORG (AFTER AN UNLOAD) ONLY. SUBMITTED    *
//* WITH TYPRUN=HOLD - RELEASE ONLY UNDER AN APPROVED CHANGE.         *
//*-------------------------------------------------------------------*
//* FOR A REORG OF ONE FILE, RESTART AT ITS STEP AND CANCEL THE JOB   *
//* WHEN THAT STEP ENDS - DO NOT LET THE FOLLOWING STEPS RUN.         *
//*   DEF010 CFDEFCIF  CIF MASTER            DEF080 CFDEFCTL  CIF CTL *
//*   DEF020 DDDEFACM  ACCOUNT MASTER + AIX  DEF090 INDEFRTP  RATES   *
//*   DEF030 PSDEFMEM  MEMO LOG + EXT REF    DEF100 CQDEFCHQ  CHEQUES *
//*   DEF040 SODEFMST  SO MASTER + DUE AIX   DEF110 LNDEFMST  LOANS   *
//*   DEF050 DMDEFMND  DD MANDATES           DEF120 FXDEFRAT  FX RATES*
//*   DEF060 DDDEFHLD  FUNDS HOLDS           DEF130 INDEFNTC  NOTICES *
//*   DEF065 CGDEFPND  PENDING CHARGES       DEF135 STDEFADH  AD-HOC  *
//*   DEF070 PRDEFPRM  PRODUCT PARAMETERS    DEF136 CSDEFSWT  CASS    *
//*   DEF075 DDDEFNOC  ACCOUNT NO CONTROL    DEF138 PSDEFCKP  ARC CKPT*
//*                                          DEF140 MBKGDG2   GDGS    *
//* DEF075 AND DEF080 EMPTY THE NUMBER CONTROL FILES - RELOAD THEM    *
//* BEFORE CICS OPENS ACCTNOC / CIFCTL (SEE THE MEMBER HEADERS).      *
//* DEF140 IS NOT DESTRUCTIVE BUT ENDS CC 12 IF ANY BASE EXISTS.      *
//* DEF138 LOSES THE PSARC01 RESTART POINT - NOT WHILE A PSARC01 RUN  *
//* IS INCOMPLETE (SEE THE PSDEFCKP HEADER).                          *
//*-------------------------------------------------------------------*
//* 2011-06-13 JNB  DEF040-DEF140 FOR THE 2010/2011 SUITES            *
//* 2014-08-11 PDQ  DEF138 PSDEFCKP (PSARC010 CHECKPOINT KSDS)        *
//* 2017-03-06 PDQ  DEF141-143 SWEEP, ALERT PREFS, TAX SELF-CERT      *
//*********************************************************************
//DEF010   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(CFDEFCIF)
//*
//DEF020   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(DDDEFACM)
//*
//DEF030   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(PSDEFMEM)
//*
//DEF040   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(SODEFMST)
//*
//DEF050   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(DMDEFMND)
//*
//DEF060   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(DDDEFHLD)
//*
//DEF065   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(CGDEFPND)
//*
//DEF070   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(PRDEFPRM)
//*
//DEF075   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(DDDEFNOC)
//*
//DEF080   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(CFDEFCTL)
//*
//DEF090   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(INDEFRTP)
//*
//DEF100   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(CQDEFCHQ)
//*
//DEF110   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(LNDEFMST)
//*
//DEF120   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(FXDEFRAT)
//*
//DEF130   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(INDEFNTC)
//DEF135   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(STDEFADH)
//DEF136   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(CSDEFSWT)
//DEF138   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(PSDEFCKP)
//DEF141   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(SVDEFSWP)
//DEF142   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(DDDEFALP)
//DEF143   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(TXDEFRES)
//DEF140   EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(MBKGDG2)
