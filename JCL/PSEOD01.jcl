//PSEOD01  JOB (MBK,EOD,DDA),'DDA HARD POSTING',
//             CLASS=B,MSGCLASS=X,REGION=0M
//*********************************************************************
//* JOB      : PSEOD01                                                *
//* TITLE    : DDA END OF DAY HARD POSTING                            *
//* SCHEDULE : CA-7 NETWORK MBKEOD - AFTER MBKONLDN, PYINB01, CFDEC01,*
//*            INNTC01 AND CSSDLY01 (SEE SCHED/MBKEOD)               *
//* OWNER    : CORE SYSTEMS - DDA         ON-CALL: ROTA CS-DDA        *
//*-------------------------------------------------------------------*
//* PS004  MAKE SURE EVERY BATCH POSTING FEED EXISTS (EMPTY IF THE    *
//*        FEEDING JOB DID NOT RUN SINCE THE LAST POSTING)            *
//* PS005  BACKUP ACCOUNT MASTER (RESTART POINT FOR PS020)            *
//* PS006  UNLOAD THE MEMO LOG                                        *
//* PS010  SORT MEMO LOG + INBOUND CREDITS + BATCH FEEDS              *
//* PS015  RECONCILE MEMO LOG TO ACCOUNT MASTER MEMO TOTALS (PSRCN010)*
//* PS020  HARD POST (PSEOD010) - UPDATES ACCTMAST + MBK.TXNHIST      *
//* PS030  EMPTY MEMO LOG AND EXTERNAL REFERENCE FILE FOR TOMORROW    *
//* PS035  DELETE THE BATCH POSTING FEEDS NOW POSTED                  *
//*-------------------------------------------------------------------*
//* BATCH POSTING FEEDS (MBK.PRD.PST.FEED.*)                          *
//*   EACH FEEDING JOB WRITES ITS POSTINGS WITH DISP=MOD TO A FIXED   *
//*   DATASET NAME. PS004 CREATES ANY THAT ARE MISSING, PS010 SORTS   *
//*   THEM IN, AND PS035 DELETES THEM ONLY AFTER PS020 ENDS RC 0/4.   *
//*   A FEEDER THAT RUNS TWICE BEFORE POSTING APPENDS - THE SECOND    *
//*   RUN'S POSTINGS ARE REJECTED AS DUPLICATES BY PSEOD010 (EXT REF).*
//*     INTPOST  INCAP01   CHGPOST  CGCHG01   REFPOST  CGREF01        *
//*     SOPOST   SOEXE01   CLSPOST  DDCLS01   DDPOST   DMCOL01        *
//*     MATPOST  INFTD01   CHQPOST  CQCLR01   UNCPOST  CQCLR01        *
//*     CRDPOST  CDSTL01   LNDRAW   LNDLY01   LNREPAY  LNDLY01        *
//*     DECPOST  CFDEC01   NTCPOST  INNTC01   CSSPOST  CSSDLY01       *
//*     SWPPOST  SVSWP01   RDRPOST  CMPRD01   ATMPOST  ATMSTL01       *
//*     BGCPOST  PYBGC01                                              *
//*-------------------------------------------------------------------*
//* RESTART                                                           *
//*   ABEND IN PS004-PS015 : RESTART FROM THE FAILING STEP            *
//*   RC 8 FROM PS015      : MORE THAN 25 MEMO BREAKS. DDA OPERATIONS *
//*                          DECIDE - RERUN PS015 WITH FIX=Y, THEN    *
//*                          RESTART AT PS020                         *
//*   ABEND IN PS020       : SEE PSEOD010 HEADER - RESTORE ACCTMAST   *
//*                          FROM PS005 BACKUP, DBA DELETES TXNHIST   *
//*                          ROWS FOR THE RUN ID, RESTART AT PS020    *
//*   ABEND IN PS030/PS035 : RESTART AT THE FAILING STEP - DO NOT     *
//*                          RERUN PS020                              *
//* RC 4 FROM PS020 = REJECTED POSTINGS. NETWORK CONTINUES, TICKET    *
//* RAISED FOR DDA OPERATIONS (REPORT IN MBK.PRD.PST.REJECTS(0)).     *
//*-------------------------------------------------------------------*
//* 1994-02-28 GHT  ORIGINAL                                          *
//* 1999-08-16 KLM  DB2 (IKJEFT01) FOR TXNHIST                        *
//* 2002-02-11 DKP  PS030 ALSO EMPTIES THE EXTERNAL REFERENCE FILE    *
//* 2004-11-15 SAT  PS015 MEMO RECONCILIATION (PIR 2004/077)          *
//* 2008-04-14 AOS  INBOUND CREDITS (PYINB01) ADDED TO PS010          *
//* 2010-03-08 AOS  BATCH POSTING FEEDS (PS004 / PS035) FOR THE 2010  *
//*                 INTEREST, CHARGES, SO AND DD SUITES (CR 10/0141)  *
//* 2010-09-06 JNB  CHEQUE, CARD AND LOAN FEEDS                       *
//* 2015-03-02 RKM  SAVINGS SWEEP FEED SWPPOST (SVSWP01)              *
//* 2016-02-08 PDQ  COMPLAINTS REDRESS FEED RDRPOST (CMPRD01)         *
//* 2016-06-20 PDQ  LINK ATM (ATMPOST) AND BRANCH CREDITS (BGCPOST)   *
//*********************************************************************
//         JCLLIB ORDER=(MBK.PRD.PROCLIB)
//*
//*-------------------------------------------------------------------*
//* PS004 - ENSURE ALL FEEDS EXIST (MOD CREATES AN EMPTY DATASET)     *
//*-------------------------------------------------------------------*
//PS004    EXEC PGM=IEFBR14
//INTPOST  DD DSN=MBK.PRD.PST.FEED.INTPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(20,5),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//CHGPOST  DD DSN=MBK.PRD.PST.FEED.CHGPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//REFPOST  DD DSN=MBK.PRD.PST.FEED.REFPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(2,2),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SOPOST   DD DSN=MBK.PRD.PST.FEED.SOPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//CLSPOST  DD DSN=MBK.PRD.PST.FEED.CLSPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(2,2),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//DDPOST   DD DSN=MBK.PRD.PST.FEED.DDPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(20,10),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//MATPOST  DD DSN=MBK.PRD.PST.FEED.MATPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//CHQPOST  DD DSN=MBK.PRD.PST.FEED.CHQPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//UNCPOST  DD DSN=MBK.PRD.PST.FEED.UNCPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//CRDPOST  DD DSN=MBK.PRD.PST.FEED.CRDPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(30,10),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//LNDRAW   DD DSN=MBK.PRD.PST.FEED.LNDRAW,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(2,2),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//LNREPAY  DD DSN=MBK.PRD.PST.FEED.LNREPAY,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//DECPOST  DD DSN=MBK.PRD.PST.FEED.DECPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//NTCPOST  DD DSN=MBK.PRD.PST.FEED.NTCPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//CSSPOST  DD DSN=MBK.PRD.PST.FEED.CSSPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SWPPOST  DD DSN=MBK.PRD.PST.FEED.SWPPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(2,2),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//RDRPOST  DD DSN=MBK.PRD.PST.FEED.RDRPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//ATMPOST  DD DSN=MBK.PRD.PST.FEED.ATMPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//BGCPOST  DD DSN=MBK.PRD.PST.FEED.BGCPOST,DISP=(MOD,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//*-------------------------------------------------------------------*
//* PS005 - BACKUP ACCOUNT MASTER                                     *
//*-------------------------------------------------------------------*
//PS005    EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//ACCTIN   DD DISP=SHR,DSN=MBK.PRD.DDA.ACCTMAST
//ACCTBKP  DD DSN=MBK.PRD.DDA.ACCTMAST.BKUP(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(600,60),RLSE),
//            DCB=(RECFM=FB,LRECL=400,BLKSIZE=0)
//SYSIN    DD *
  REPRO INFILE(ACCTIN) OUTFILE(ACCTBKP)
/*
//*-------------------------------------------------------------------*
//* PS006 - UNLOAD MEMO LOG (EMPTY LOG IS NOT AN ERROR)               *
//*-------------------------------------------------------------------*
//PS006    EXEC PGM=IDCAMS,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//MEMOIN   DD DISP=SHR,DSN=MBK.PRD.PST.MEMOLOG
//MEMOOUT  DD DSN=MBK.PRD.PST.MEMOLOG.UNLOAD(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(150,30),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSIN    DD *
  REPRO INFILE(MEMOIN) OUTFILE(MEMOOUT)
  IF LASTCC = 4 THEN SET MAXCC = 0
/*
//*-------------------------------------------------------------------*
//* PS010 - SORT POSTINGS                                             *
//*-------------------------------------------------------------------*
//PS010    EXEC PGM=SORT,COND=(0,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DISP=SHR,DSN=MBK.PRD.PST.MEMOLOG.UNLOAD(+1)
//         DD DISP=SHR,DSN=MBK.PRD.PAY.INBOUND.POSTINGS(0)
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.INTPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.CHGPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.REFPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.SOPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.CLSPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.DDPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.MATPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.CHQPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.UNCPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.CRDPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.LNDRAW
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.LNREPAY
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.DECPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.NTCPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.CSSPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.SWPPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.RDRPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.ATMPOST
//         DD DISP=SHR,DSN=MBK.PRD.PST.FEED.BGCPOST
//SORTOUT  DD DSN=MBK.PRD.PST.POSTINGS.SORTED(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(300,60),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSIN    DD DISP=SHR,DSN=MBK.PRD.CNTL(PSSORT)
//*-------------------------------------------------------------------*
//* PS015 - MEMO RECONCILIATION (PSRCN010). CHANGE FIX=N TO FIX=Y     *
//*         ONLY ON THE INSTRUCTION OF DDA OPERATIONS                 *
//*-------------------------------------------------------------------*
//PS015    EXEC MBKBATCH,PGM=PSRCN010,COND=(0,LT)
//STEP.MEMOSRT  DD DISP=SHR,DSN=MBK.PRD.PST.POSTINGS.SORTED(+1)
//STEP.ACCTMAST DD DISP=OLD,DSN=MBK.PRD.DDA.ACCTMAST
//STEP.PARMIN   DD *
FIX=N
/*
//STEP.BREAKS   DD DSN=MBK.PRD.PST.MEMO.BREAKS(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//STEP.REPORT   DD SYSOUT=(R,,PSR1),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
//*-------------------------------------------------------------------*
//* PS020 - HARD POSTING                                              *
//*-------------------------------------------------------------------*
//PS020    EXEC MBKDB2B,COND=(4,LT)
//STEP.POSTIN   DD DISP=SHR,DSN=MBK.PRD.PST.POSTINGS.SORTED(+1)
//STEP.ACCTMAST DD DISP=OLD,DSN=MBK.PRD.DDA.ACCTMAST
//STEP.REJECTS  DD DSN=MBK.PRD.PST.REJECTS(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//STEP.JOURNAL  DD SYSOUT=(R,,PSJ1),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
//STEP.SYSTSIN  DD *
 DSN SYSTEM(DB2P)
 RUN PROGRAM(PSEOD010) PLAN(PSEOD010) LIB('MBK.PRD.LOADLIB')
 END
/*
//*-------------------------------------------------------------------*
//* PS030 - EMPTY MEMO LOG AND EXTERNAL REFERENCE FILE                *
//*         ONLY IF PS020 ENDED RC 0 OR 4                             *
//*-------------------------------------------------------------------*
//PS030    EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//EMPTY200 DD DUMMY,DCB=(RECFM=FB,LRECL=200)
//EMPTY80  DD DUMMY,DCB=(RECFM=FB,LRECL=80)
//SYSIN    DD *
  REPRO INFILE(EMPTY200) OUTDATASET(MBK.PRD.PST.MEMOLOG) REUSE
  IF LASTCC = 4 THEN SET MAXCC = 0
  REPRO INFILE(EMPTY80) OUTDATASET(MBK.PRD.PST.EXTREF) REUSE
  IF LASTCC = 4 THEN SET MAXCC = 0
/*
//*-------------------------------------------------------------------*
//* PS035 - DELETE THE POSTED FEEDS (RECREATED EMPTY BY TOMORROW'S    *
//*         PS004 IF THE FEEDING JOB DOES NOT RUN)                    *
//*-------------------------------------------------------------------*
//PS035    EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE MBK.PRD.PST.FEED.INTPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.CHGPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.REFPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.SOPOST  NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.CLSPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.DDPOST  NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.MATPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.CHQPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.UNCPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.CRDPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.LNDRAW  NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.LNREPAY NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.DECPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.NTCPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.CSSPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.SWPPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.RDRPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.ATMPOST NONVSAM PURGE
  DELETE MBK.PRD.PST.FEED.BGCPOST NONVSAM PURGE
  IF MAXCC = 8 THEN SET MAXCC = 0
/*
