***********************************************************************
* MAPSET   : DMMAPS                                                   *
* TITLE    : DIRECT DEBITS - BRANCH MANDATE LIST / CANCEL             *
* PROGRAM  : DMSCRN1   TRANSACTION DM01                               *
* TERMINAL : 3270 MODEL 2 (24 X 80)                                   *
*---------------------------------------------------------------------*
* ASSEMBLE WITH PROC DFHMAPS - PRODUCES PHYSICAL MAP IN               *
* MBK.PRD.CICS.LOADLIB AND SYMBOLIC MAP IN MBK.PRD.COPYLIB(DMMAPS)    *
*---------------------------------------------------------------------*
* 2011-03-14 AOS  ORIGINAL VERSION                                    *
***********************************************************************
DMMAPS   DFHMSD TYPE=&SYSPARM,                                         X
               MODE=INOUT,                                             X
               LANG=COBOL,                                             X
               STORAGE=AUTO,                                           X
               CTRL=(FREEKB,FRSET),                                    X
               TIOAPFX=YES
*
DMM01    DFHMDI SIZE=(24,80),                                          X
               LINE=1,                                                 X
               COLUMN=1
*
*        ---- HEADER ------------------------------------------------
         DFHMDF POS=(1,1),LENGTH=4,ATTRB=(ASKIP,BRT),                  X
               INITIAL='DM01'
         DFHMDF POS=(1,20),LENGTH=38,ATTRB=(ASKIP,BRT),                X
               INITIAL='MEGABANK PLC  -  DIRECT DEBIT MANDATES'
DATE     DFHMDF POS=(1,62),LENGTH=10,ATTRB=(ASKIP,NORM)
TIME     DFHMDF POS=(1,73),LENGTH=8,ATTRB=(ASKIP,NORM)
*        ---- KEY ---------------------------------------------------
         DFHMDF POS=(3,1),LENGTH=10,ATTRB=(ASKIP,NORM),                X
               INITIAL='SORT CODE:'
SORTCD   DFHMDF POS=(3,12),LENGTH=6,ATTRB=(UNPROT,BRT,IC,FSET),        X
               HILIGHT=UNDERLINE
         DFHMDF POS=(3,19),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(3,22),LENGTH=8,ATTRB=(ASKIP,NORM),                X
               INITIAL='ACCOUNT:'
ACCTNO   DFHMDF POS=(3,31),LENGTH=8,ATTRB=(UNPROT,BRT,FSET),           X
               HILIGHT=UNDERLINE
         DFHMDF POS=(3,40),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(3,44),LENGTH=8,ATTRB=(ASKIP,NORM),                X
               INITIAL='PRODUCT:'
PRODCD   DFHMDF POS=(3,53),LENGTH=10,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(4,1),LENGTH=9,ATTRB=(ASKIP,NORM),                 X
               INITIAL='CUSTOMER:'
CUSTNM   DFHMDF POS=(4,12),LENGTH=40,ATTRB=(ASKIP,BRT)
*        ---- MANDATE LIST -----------------------------------------
         DFHMDF POS=(6,1),LENGTH=79,ATTRB=(ASKIP,BRT),                 X
               INITIAL='S SUN    ORIGINATOR         PAYER REFERENCE    X
               ST SET UP   LAST COLL      AMOUNT'
SEL1     DFHMDF POS=(7,1),LENGTH=1,ATTRB=(UNPROT,BRT,FSET)
DML1     DFHMDF POS=(7,3),LENGTH=77,ATTRB=(ASKIP,NORM)
SEL2     DFHMDF POS=(8,1),LENGTH=1,ATTRB=(UNPROT,BRT,FSET)
DML2     DFHMDF POS=(8,3),LENGTH=77,ATTRB=(ASKIP,NORM)
SEL3     DFHMDF POS=(9,1),LENGTH=1,ATTRB=(UNPROT,BRT,FSET)
DML3     DFHMDF POS=(9,3),LENGTH=77,ATTRB=(ASKIP,NORM)
SEL4     DFHMDF POS=(10,1),LENGTH=1,ATTRB=(UNPROT,BRT,FSET)
DML4     DFHMDF POS=(10,3),LENGTH=77,ATTRB=(ASKIP,NORM)
SEL5     DFHMDF POS=(11,1),LENGTH=1,ATTRB=(UNPROT,BRT,FSET)
DML5     DFHMDF POS=(11,3),LENGTH=77,ATTRB=(ASKIP,NORM)
SEL6     DFHMDF POS=(12,1),LENGTH=1,ATTRB=(UNPROT,BRT,FSET)
DML6     DFHMDF POS=(12,3),LENGTH=77,ATTRB=(ASKIP,NORM)
SEL7     DFHMDF POS=(13,1),LENGTH=1,ATTRB=(UNPROT,BRT,FSET)
DML7     DFHMDF POS=(13,3),LENGTH=77,ATTRB=(ASKIP,NORM)
SEL8     DFHMDF POS=(14,1),LENGTH=1,ATTRB=(UNPROT,BRT,FSET)
DML8     DFHMDF POS=(14,3),LENGTH=77,ATTRB=(ASKIP,NORM)
SEL9     DFHMDF POS=(15,1),LENGTH=1,ATTRB=(UNPROT,BRT,FSET)
DML9     DFHMDF POS=(15,3),LENGTH=77,ATTRB=(ASKIP,NORM)
SEL10    DFHMDF POS=(16,1),LENGTH=1,ATTRB=(UNPROT,BRT,FSET)
DML10    DFHMDF POS=(16,3),LENGTH=77,ATTRB=(ASKIP,NORM)
SEL11    DFHMDF POS=(17,1),LENGTH=1,ATTRB=(UNPROT,BRT,FSET)
DML11    DFHMDF POS=(17,3),LENGTH=77,ATTRB=(ASKIP,NORM)
SEL12    DFHMDF POS=(18,1),LENGTH=1,ATTRB=(UNPROT,BRT,FSET)
DML12    DFHMDF POS=(18,3),LENGTH=77,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(20,1),LENGTH=40,ATTRB=(ASKIP,NORM),               X
               INITIAL='X = CANCEL (CONFIRM WITH PF5)'
         DFHMDF POS=(20,45),LENGTH=28,ATTRB=(ASKIP,NORM),              X
               INITIAL='INCLUDE CANCELLED (Y/N):'
INCCAN   DFHMDF POS=(20,74),LENGTH=1,ATTRB=(UNPROT,BRT,FSET),          X
               HILIGHT=UNDERLINE
         DFHMDF POS=(20,76),LENGTH=1,ATTRB=ASKIP
*        ---- MESSAGE AND KEYS --------------------------------------
MSG      DFHMDF POS=(22,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=60,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=PROCESS PF3=EXIT PF5=CONFIRM CANCEL PF8=MX
               ORE PF12=CF02'
*
         DFHMSD TYPE=FINAL
         END
